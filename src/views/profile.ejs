<%- include('partials/header', { activePage: 'profile' }) %>
<main>
  <div class="content-split">
    <div class="intro-block">
      <h1><%= siteData.getTitle() %></h1>
      <h2>Welcome to <%= siteData.getName() %><%= siteData.getNameHeadingHelp() %>Flash Card Service!</h2>
      <%- include('partials/mission') %>
    </div>

    <div class="card-grid vertical-stack">
      <!-- User Profile Section -->
      <section class="profile-section">
        <h3>Your Profile</h3>
        <form id="profileForm">
          <div class="form-section">
            <div class="form-group">
              <label for="username">Username</label>
              <input id="username" name="username" type="text" disabled />
              <small>Username cannot be changed</small>
            </div>

            <div class="form-group">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" required />
            </div>

            <div class="form-group">
              <label for="fullName">Full Name</label>
              <input id="fullName" name="fullName" type="text" />
            </div>

            <div class="form-group">
              <label for="accountStatus">Account Status</label>
              <input id="accountStatus" name="accountStatus" type="text" disabled />
            </div>
          </div>

          <button type="submit" id="updateProfileBtn">Update Profile</button>
        </form>
        <div id="profileStatus"></div>

        <div class="form-group form-group-spaced">
          <label>
            <input id="isPublicToggle" name="isPublic" type="checkbox" />
            List me in the share directory (public user)
          </label>
          <small>
            Public users appear in the share combo box. Users not listed can still
            receive shares when their exact username is typed.
          </small>
        </div>
        <div id="visibilityStatus"></div>

        <div class="form-group form-group-spaced">
          <label>Storage</label>
          <div id="storageUsage" class="text-muted">Loading storage usage…</div>
        </div>
      </section>

      <!-- Change Password Section -->
      <section class="profile-section">
        <h3>Change Password</h3>
        <form id="changePasswordForm">
          <div class="form-section">
            <div class="form-group">
              <label for="newPassword">New Password</label>
              <input id="newPassword" name="newPassword" type="password" required />
              <small>Password requirements:</small>
              <ul>
                <li>At least 8 characters</li>
                <li>At least one uppercase letter (A-Z)</li>
                <li>At least one lowercase letter (a-z)</li>
                <li>At least one number (0-9)</li>
                <li>At least one special character (!@#$%^&*)</li>
              </ul>
            </div>

            <div class="form-group">
              <label for="confirmPassword">Confirm New Password</label>
              <input id="confirmPassword" name="confirmPassword" type="password" required />
            </div>
          </div>

          <button type="submit" id="changePasswordBtn">Change Password</button>
        </form>
        <div id="changePasswordStatus"></div>
      </section>

      <!-- Pending Shares Section -->
      <section class="profile-section">
        <h3>Pending Shares</h3>
        <p class="section-intro">
          Flashcards other users have shared with you. Accept to add them to your
          "Shared with Me" list, or reject to decline (the owner is not notified).
        </p>
        <div id="pendingSharesControls" class="pending-shares-controls hidden">
          <label class="select-all-label">
            <input type="checkbox" id="select-all-pending" />
            Select All
          </label>
          <button type="button" id="accept-selected-btn">Accept Selected</button>
          <button type="button" id="reject-selected-btn" class="btn-danger">Reject Selected</button>
        </div>
        <div id="pendingSharesList">
          <p class="text-muted">Loading pending shares...</p>
        </div>
        <div id="pendingSharesStatus"></div>
      </section>

      <!-- Admin Section (only visible to admins) -->
      <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
        <section class="admin-section">
          <h3>Admin: User Management</h3>
          <p class="section-intro">Manage all users in the system</p>

          <!-- Create New User Form -->
          <div class="form-section">
            <h4 class="form-section-title">Create New User</h4>
            <form id="createUserForm">
              <div class="form-group">
                <label for="newUsername">Username</label>
                <input id="newUsername" name="username" type="text" required />
                <small>3-50 characters, letters/numbers/underscore/hyphen only</small>
              </div>

              <div class="form-group">
                <label for="newEmail">Email</label>
                <input id="newEmail" name="email" type="email" required />
              </div>

              <div class="form-group">
                <label for="newFullName">Full Name (optional)</label>
                <input id="newFullName" name="fullName" type="text" />
              </div>

              <div class="form-group">
                <label for="newUserPassword">Password</label>
                <input id="newUserPassword" name="password" type="password" required />
                <small>Password requirements:</small>
                <ul>
                  <li>At least 8 characters</li>
                  <li>At least one uppercase letter (A-Z)</li>
                  <li>At least one lowercase letter (a-z)</li>
                  <li>At least one number (0-9)</li>
                  <li>At least one special character (!@#$%^&*)</li>
                </ul>
              </div>

              <div class="form-group">
                <label for="confirmNewUserPassword">Confirm Password</label>
                <input id="confirmNewUserPassword" name="confirmPassword" type="password" required />
              </div>

              <div class="form-group">
                <label>
                  <input id="newUserIsPublic" name="isPublic" type="checkbox" />
                  List in the share directory (public user)
                </label>
              </div>

              <button type="submit" id="createUserBtn">Create User</button>
            </form>
            <div id="createUserStatus"></div>
          </div>

          <!-- Users List -->
          <div class="form-section">
            <h4 class="form-section-title">Current Users</h4>
            <div id="usersList">
              <p class="text-muted">Loading users...</p>
            </div>
          </div>

          <!-- Backup / Restore -->
          <div class="form-section">
            <h4 class="form-section-title">Backup &amp; Restore</h4>
            <p class="section-note">
              The backup is two linked files: a data JSON and a media ZIP
              (media referenced by id). Download both; import them together to
              restore media. Importing updates existing records to the
              imported values and adds new ones; nothing is deleted.
            </p>
            <p class="backup-actions">
              <a href="/api/admin/backup/download" download>
                <button type="button">⬇️ Download Backup Data (JSON)</button>
              </a>
              <a href="/api/admin/backup/download-media" download>
                <button type="button">⬇️ Download Backup Media (ZIP)</button>
              </a>
            </p>
            <div class="form-group">
              <label for="backupFile">Import Backup Data (JSON)</label>
              <input id="backupFile" name="backupFile" type="file" accept="application/json,.json" />
            </div>
            <div class="form-group">
              <label for="backupMediaFile">Import Backup Media (ZIP, optional)</label>
              <input id="backupMediaFile" name="backupMediaFile" type="file" accept="application/zip,.zip" />
            </div>
            <button type="button" id="importBackupBtn">⬆️ Import Backup</button>
            <div id="backupStatus"></div>
          </div>
        </section>
      <% } %>
    </div>
  </div>

  <script>
    // Initialize with server-side values
    window.currentUserId = '<%= typeof currentUserId !== "undefined" ? currentUserId : "" %>';

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text ?? '';
      return div.innerHTML;
    }

    // Load pending shares awaiting accept/reject
    async function loadPendingShares() {
      const list = document.getElementById('pendingSharesList');
      if (!list) return;

      try {
        const response = await fetch('/api/entries/shares/pending', {
          credentials: 'include',
        });
        const data = await response.json();

        const controls = document.getElementById('pendingSharesControls');
        if (data.status === 'success' && data.shares && data.shares.length > 0) {
          if (controls) controls.classList.remove('hidden');
          list.innerHTML = data.shares
            .map(
              (share) => `
            <div class="pending-share-card">
              <label class="pending-share-select" title="Select for batch accept/reject">
                <input type="checkbox" class="pending-select" data-share-id="${share.share_id}" />
              </label>
              <div class="pending-share-content">
                <div class="pending-share-question">${escapeHtml(share.question)}</div>
                <div class="pending-share-meta">
                  Shared by <strong>${escapeHtml(share.full_name || share.username)}</strong>
                  ${share.lesson ? ' • Lesson: ' + escapeHtml(share.lesson) : ''}
                </div>
              </div>
              <div class="pending-share-actions">
                <button class="btn btn-primary" onclick="acceptPendingShare('${share.share_id}')">
                  Accept
                </button>
                <button class="btn btn-danger" onclick="rejectPendingShare('${share.share_id}')">
                  Reject
                </button>
              </div>
            </div>
          `
            )
            .join('');
        } else if (data.status === 'success') {
          if (controls) controls.classList.add('hidden');
          list.innerHTML = '<p class="text-muted">No pending shares.</p>';
        } else {
          list.innerHTML = `<p class="error">Failed to load pending shares: ${escapeHtml(data.message)}</p>`;
        }
      } catch (error) {
        list.innerHTML = `<p class="error">Error loading pending shares: ${escapeHtml(error.message)}</p>`;
      }
    }

    async function acceptPendingShare(shareId) {
      try {
        const response = await fetch(`/api/entries/shares/${shareId}/accept`, {
          method: 'POST',
          credentials: 'include',
        });
        const data = await response.json();

        if (response.ok) {
          loadPendingShares();
        } else {
          alert(`Failed: ${data.message}`);
        }
      } catch (error) {
        alert(`Error: ${error.message}`);
      }
    }

    async function rejectPendingShare(shareId) {
      if (!confirm('Reject this shared flashcard? The owner is not notified.')) return;

      try {
        const response = await fetch(`/api/entries/shares/${shareId}/reject`, {
          method: 'POST',
          credentials: 'include',
        });
        const data = await response.json();

        if (response.ok) {
          loadPendingShares();
        } else {
          alert(`Failed: ${data.message}`);
        }
      } catch (error) {
        alert(`Error: ${error.message}`);
      }
    }

    // Fetch and populate user profile
    async function loadProfile() {
      try {
        const response = await fetch('/api/users/profile', {
          credentials: 'include',
        });
        const data = await response.json();

        if (data.status === 'success') {
          const user = data.user;
          document.getElementById('username').value = user.username;
          document.getElementById('email').value = user.email || '';
          document.getElementById('fullName').value = user.full_name || '';
          document.getElementById('accountStatus').value = user.status || 'active';
          document.getElementById('isPublicToggle').checked = Boolean(user.is_public);

          // Store original data for comparison
          window.originalUser = user;
        } else {
          document.getElementById('profileStatus').innerHTML =
            `<p class="error">Failed to load profile: ${data.message}</p>`;
        }
      } catch (error) {
        document.getElementById('profileStatus').innerHTML =
          `<p class="error">Error loading profile: ${error.message}</p>`;
      }
    }

    // Update profile
    document.getElementById('profileForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      const email = document.getElementById('email').value;
      const fullName = document.getElementById('fullName').value;
      const statusDiv = document.getElementById('profileStatus');

      try {
        const response = await fetch('/api/users/profile', {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
          },
          credentials: 'include',
          body: JSON.stringify({ email, fullName }),
        });

        const data = await response.json();

        if (response.ok) {
          statusDiv.innerHTML = '<p class="success">Profile updated successfully!</p>';
          // Update original data
          window.originalUser = data.user;
        } else {
          statusDiv.innerHTML = `<p class="error">Update failed: ${data.message}</p>`;
        }
      } catch (error) {
        statusDiv.innerHTML = `<p class="error">Error: ${error.message}</p>`;
      }
    });

    // Change password handler
    document.getElementById('changePasswordForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      const newPassword = document.getElementById('newPassword').value;
      const confirmPassword = document.getElementById('confirmPassword').value;
      const statusDiv = document.getElementById('passwordStatus');

      // Validate passwords match
      if (newPassword !== confirmPassword) {
        statusDiv.innerHTML = '<p class="error">Passwords do not match</p>';
        return;
      }

      try {
        const response = await fetch('/api/users/password', {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
          },
          credentials: 'include',
          body: JSON.stringify({ password: newPassword }),
        });

        const data = await response.json();

        if (response.ok) {
          statusDiv.innerHTML = '<p class="success">Password changed successfully!</p>';
          // Clear the form
          document.getElementById('changePasswordForm').reset();
          setTimeout(() => {
            statusDiv.innerHTML = '';
          }, 3000);
        } else {
          statusDiv.innerHTML = `<p class="error">Failed: ${data.message}</p>`;
        }
      } catch (error) {
        statusDiv.innerHTML = `<p class="error">Error: ${error.message}</p>`;
      }
    });

    // Load admin users list
    async function loadAdminUsersList() {
      const adminSection = document.querySelector('.admin-section');
      if (!adminSection) return; // Not admin

      try {
        const response = await fetch('/api/admin/users', {
          credentials: 'include',
        });
        const data = await response.json();

        if (data.status === 'success') {
          const usersList = document.getElementById('usersList');
          let html = '<table class="admin-users-table"><thead><tr>';
          html += '<th>Username</th><th>Email</th><th>Full Name</th><th>Status</th><th>Admin</th><th>Public</th><th>Actions</th></tr></thead><tbody>';

          data.users.forEach((user) => {
            const isCurrentUser = window.currentUserId === user.user_id;
            const isAdmin = user.is_admin ? '✓' : '–';
            const isPublic = user.is_public ? '✓' : '–';
            const status = user.status || 'active';
            const actionDisabled = isCurrentUser ? 'disabled' : '';

            html += `<tr>`;
            html += `<td>${user.username}</td>`;
            html += `<td>${user.email}</td>`;
            html += `<td>${user.full_name || '–'}</td>`;
            html += `<td><span class="status-badge ${status}">${status}</span></td>`;
            html += `<td>${isAdmin}</td>`;
            html += `<td>${isPublic}</td>`;
            html += `<td>`;

            if (!isCurrentUser) {
              if (status === 'active') {
                html += `<button onclick="disableUser('${user.user_id}')">Disable</button>`;
              } else {
                html += `<button onclick="enableUser('${user.user_id}')">Enable</button>`;
              }
              if (user.is_admin) {
                html += `<button onclick="demoteUser('${user.user_id}', '${user.username}')">Remove Admin</button>`;
              } else {
                html += `<button onclick="promoteUser('${user.user_id}', '${user.username}')">Make Admin</button>`;
              }
              if (user.is_public) {
                html += `<button onclick="setUserVisibility('${user.user_id}', '${user.username}', false)">Make Private</button>`;
              } else {
                html += `<button onclick="setUserVisibility('${user.user_id}', '${user.username}', true)">Make Public</button>`;
              }
              html += `<button onclick="deleteUser('${user.user_id}', '${user.username}')" class="btn-danger">Delete</button>`;
            } else {
              html += '<span class="text-muted">Current User</span>';
            }

            html += `</td></tr>`;
          });

          html += '</tbody></table>';
          usersList.innerHTML = html;
        } else {
          document.getElementById('usersList').innerHTML =
            `<p class="error">Failed to load users: ${data.message}</p>`;
        }
      } catch (error) {
        document.getElementById('usersList').innerHTML =
          `<p class="error">Error loading users: ${error.message}</p>`;
      }
    }

    // Create new user handler
    if (document.getElementById('createUserForm')) {
      document.getElementById('createUserForm').addEventListener('submit', async (e) => {
        e.preventDefault();

        const username = document.getElementById('newUsername').value;
        const email = document.getElementById('newEmail').value;
        const fullName = document.getElementById('newFullName').value || null;
        const password = document.getElementById('newUserPassword').value;
        const confirmPassword = document.getElementById('confirmNewUserPassword').value;
        const isPublic = document.getElementById('newUserIsPublic').checked;
        const statusDiv = document.getElementById('createUserStatus');

        // Validate passwords match
        if (password !== confirmPassword) {
          statusDiv.innerHTML = '<p class="error">Passwords do not match</p>';
          return;
        }

        try {
          const response = await fetch('/api/admin/users', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            credentials: 'include',
            body: JSON.stringify({ username, email, fullName, password, isPublic }),
          });

          const data = await response.json();

          if (response.ok) {
            statusDiv.innerHTML = '<p class="success">User created successfully!</p>';
            // Clear the form
            document.getElementById('createUserForm').reset();
            // Reload users list
            setTimeout(() => {
              loadAdminUsersList();
              statusDiv.innerHTML = '';
            }, 1500);
          } else {
            statusDiv.innerHTML = `<p class="error">Failed: ${data.message}</p>`;
            if (data.errors) {
              data.errors.forEach((err) => {
                statusDiv.innerHTML += `<p class="error">• ${err}</p>`;
              });
            }
          }
        } catch (error) {
          statusDiv.innerHTML = `<p class="error">Error: ${error.message}</p>`;
        }
      });
    }

    // Admin actions
    async function disableUser(userId) {
      if (!confirm('Are you sure you want to disable this user?')) return;

      try {
        const response = await fetch(`/api/admin/users/${userId}/disable`, {
          method: 'POST',
        });

        const data = await response.json();

        if (response.ok) {
          alert('User disabled successfully');
          loadAdminUsersList();
        } else {
          alert(`Failed: ${data.message}`);
        }
      } catch (error) {
        alert(`Error: ${error.message}`);
      }
    }

    async function enableUser(userId) {
      if (!confirm('Are you sure you want to enable this user?')) return;

      try {
        const response = await fetch(`/api/admin/users/${userId}/enable`, {
          method: 'POST',
        });

        const data = await response.json();

        if (response.ok) {
          alert('User enabled successfully');
          loadAdminUsersList();
        } else {
          alert(`Failed: ${data.message}`);
        }
      } catch (error) {
        alert(`Error: ${error.message}`);
      }
    }

    async function deleteUser(userId, username) {
      if (!confirm(`Are you sure you want to DELETE user "${username}"? This action cannot be undone.`)) return;

      try {
        const response = await fetch(`/api/admin/users/${userId}`, {
          method: 'DELETE',
        });

        const data = await response.json();

        if (response.ok) {
          alert('User deleted successfully');
          loadAdminUsersList();
        } else {
          alert(`Failed: ${data.message}`);
        }
      } catch (error) {
        alert(`Error: ${error.message}`);
      }
    }

    async function promoteUser(userId, username) {
      if (!confirm(`Make "${username}" a system admin?`)) return;

      try {
        const response = await fetch(`/api/admin/users/${userId}/promote`, {
          method: 'POST',
        });

        const data = await response.json();

        if (response.ok) {
          alert(data.message);
          loadAdminUsersList();
        } else {
          alert(`Failed: ${data.message}`);
        }
      } catch (error) {
        alert(`Error: ${error.message}`);
      }
    }

    async function demoteUser(userId, username) {
      if (!confirm(`Remove system admin from "${username}"?`)) return;

      try {
        const response = await fetch(`/api/admin/users/${userId}/demote`, {
          method: 'POST',
        });

        const data = await response.json();

        if (response.ok) {
          alert(data.message);
          loadAdminUsersList();
        } else {
          alert(`Failed: ${data.message}`);
        }
      } catch (error) {
        alert(`Error: ${error.message}`);
      }
    }

    async function setUserVisibility(userId, username, isPublic) {
      const action = isPublic ? 'public (listed in the share directory)' : 'private';
      if (!confirm(`Make "${username}" ${action}?`)) return;

      try {
        const response = await fetch(`/api/admin/users/${userId}/visibility`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify({ isPublic }),
        });

        const data = await response.json();

        if (response.ok) {
          alert(data.message);
          loadAdminUsersList();
        } else {
          alert(`Failed: ${data.message}`);
        }
      } catch (error) {
        alert(`Error: ${error.message}`);
      }
    }

    async function resolveSelectedPendingShares(action) {
      const ids = [...document.querySelectorAll('.pending-select:checked')].map(
        (box) => box.dataset.shareId
      );
      const statusDiv = document.getElementById('pendingSharesStatus');

      if (ids.length === 0) {
        statusDiv.innerHTML = '<p class="error">Check at least one pending share first</p>';
        return;
      }

      if (
        action === 'reject' &&
        !confirm(`Reject ${ids.length} selected share(s)? The owners are not notified.`)
      ) {
        return;
      }

      let done = 0;
      const failures = [];
      for (const shareId of ids) {
        try {
          const response = await fetch(`/api/entries/shares/${shareId}/${action}`, {
            method: 'POST',
            credentials: 'include',
          });
          if (response.ok) {
            done += 1;
          } else {
            const data = await response.json();
            failures.push(data.message);
          }
        } catch (error) {
          failures.push(error.message);
        }
      }

      let html = `<p class="success">${done} share(s) ${action}ed.</p>`;
      if (failures.length > 0) {
        html += `<p class="error">${failures.length} failed; first: ${failures[0]}</p>`;
      }
      statusDiv.innerHTML = html;
      loadPendingShares();
    }

    // Import a JSON backup with upsert semantics
    if (document.getElementById('importBackupBtn')) {
      document.getElementById('importBackupBtn').addEventListener('click', async () => {
        const fileInput = document.getElementById('backupFile');
        const statusDiv = document.getElementById('backupStatus');

        if (!fileInput.files || fileInput.files.length === 0) {
          statusDiv.innerHTML = '<p class="error">Select a backup JSON file first</p>';
          return;
        }

        if (!confirm('Import this backup? Existing records will be updated to the imported values.')) {
          return;
        }

        try {
          const text = await fileInput.files[0].text();
          const parsed = JSON.parse(text);
          // Accept either a raw backup object or an export endpoint response
          const backup = parsed.backup || parsed;

          // Two-file model: attach the linked media ZIP when provided
          let mediaArchive = null;
          const mediaInput = document.getElementById('backupMediaFile');
          if (mediaInput && mediaInput.files && mediaInput.files.length > 0) {
            mediaArchive = await new Promise((resolve, reject) => {
              const reader = new FileReader();
              reader.onload = () => resolve(String(reader.result).split(',')[1]);
              reader.onerror = reject;
              reader.readAsDataURL(mediaInput.files[0]);
            });
          }

          statusDiv.innerHTML = '<p>Importing…</p>';

          const response = await fetch('/api/admin/backup/import', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({ backup, mediaArchive }),
          });

          const data = await response.json();

          if (response.ok) {
            const counts = Object.entries(data.results.imported)
              .filter(([, n]) => n > 0)
              .map(([t, n]) => `${t}: ${n}`)
              .join(', ');
            let html = `<p class="success">Import complete. ${counts || 'No rows imported.'}</p>`;
            if (data.results.warnings && data.results.warnings.length > 0) {
              html += `<p class="error">${data.results.warnings.length} warning(s); first: ${data.results.warnings[0]}</p>`;
            }
            statusDiv.innerHTML = html;
            loadAdminUsersList();
          } else {
            statusDiv.innerHTML = `<p class="error">Import failed: ${data.message}</p>`;
          }
        } catch (error) {
          statusDiv.innerHTML = `<p class="error">Import error: ${error.message}</p>`;
        }
      });
    }

    async function loadStorageUsage() {
      const el = document.getElementById('storageUsage');
      try {
        const response = await fetch('/api/entries/storage', { credentials: 'include' });
        const data = await response.json();
        if (data.status !== 'success') return;
        const mb = (n) => (n / (1024 * 1024)).toFixed(2) + ' MB';
        if (data.maxBytes === null) {
          el.textContent = `Used ${mb(data.usedBytes)} (no limit set)`;
          return;
        }
        const pct = Math.min(100, Math.round((data.usedBytes / data.maxBytes) * 100));
        el.innerHTML = `
          Used ${mb(data.usedBytes)} of ${mb(data.maxBytes)} (${pct}%) — ${mb(data.remainingBytes)} remaining
          <div class="storage-bar">
            <div class="storage-bar-fill progress-w${Math.round(pct / 5) * 5}${data.overLimit ? ' over-limit' : ''}"></div>
          </div>
          ${data.overLimit ? '<p class="error storage-over-note">⚠️ You are over your storage limit. Remove cards or media to get back under it; creating new cards is blocked.</p>' : ''}
        `;
      } catch (error) {
        el.textContent = 'Could not load storage usage';
      }
    }

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', () => {
      loadProfile();
      loadStorageUsage();
      loadPendingShares();
      loadAdminUsersList();

      const selectAllPending = document.getElementById('select-all-pending');
      if (selectAllPending) {
        selectAllPending.addEventListener('change', (e) => {
          document.querySelectorAll('.pending-select').forEach((box) => {
            box.checked = e.target.checked;
          });
        });
      }
      const acceptSelectedBtn = document.getElementById('accept-selected-btn');
      if (acceptSelectedBtn) {
        acceptSelectedBtn.addEventListener('click', () => resolveSelectedPendingShares('accept'));
      }
      const rejectSelectedBtn = document.getElementById('reject-selected-btn');
      if (rejectSelectedBtn) {
        rejectSelectedBtn.addEventListener('click', () => resolveSelectedPendingShares('reject'));
      }

      const visibilityToggle = document.getElementById('isPublicToggle');
      if (visibilityToggle) {
        visibilityToggle.addEventListener('change', async () => {
          const statusDiv = document.getElementById('visibilityStatus');
          try {
            const response = await fetch('/api/users/visibility', {
              method: 'PUT',
              headers: { 'Content-Type': 'application/json' },
              credentials: 'include',
              body: JSON.stringify({ isPublic: visibilityToggle.checked }),
            });
            const data = await response.json();
            if (response.ok) {
              statusDiv.innerHTML = `<p class="success">${data.message}</p>`;
            } else {
              visibilityToggle.checked = !visibilityToggle.checked;
              statusDiv.innerHTML = `<p class="error">${data.message}</p>`;
            }
          } catch (error) {
            visibilityToggle.checked = !visibilityToggle.checked;
            statusDiv.innerHTML = `<p class="error">Error: ${error.message}</p>`;
          }
        });
      }
    });
  </script>
</main>
<%- include('partials/footer') %>
