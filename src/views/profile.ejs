<%- include('partials/header') %>
<main>
  <div class="content-split">
    <div class="intro-block">
      <h1><%= siteData.getTitle() %></h1>
      <h2>Welcome to <%= siteData.getName() %><%= siteData.getNameHeadingHelp() %>Flash Card Service!</h2>
      <p>Our mission is to help <%= siteData.getName() %> study for English Connect.</p>
    </div>

    <div class="card-grid vertical-stack">
      <!-- User Profile Section -->
      <section class="profile-section">
        <h3>Your Profile</h3>
        <form id="profileForm">
          <div class="form-section">
            <div class="form-group">
              <label for="username">Username</label>
              <input id="username" name="username" type="text" disabled />
              <small>Username cannot be changed</small>
            </div>

            <div class="form-group">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" required />
            </div>

            <div class="form-group">
              <label for="fullName">Full Name</label>
              <input id="fullName" name="fullName" type="text" />
            </div>

            <div class="form-group">
              <label for="accountStatus">Account Status</label>
              <input id="accountStatus" name="accountStatus" type="text" disabled />
            </div>
          </div>

          <button type="submit" id="updateProfileBtn">Update Profile</button>
        </form>
        <div id="profileStatus"></div>
      </section>

      <!-- Change Password Section -->
      <section class="profile-section">
        <h3>Change Password</h3>
        <form id="changePasswordForm">
          <div class="form-section">
            <div class="form-group">
              <label for="newPassword">New Password</label>
              <input id="newPassword" name="newPassword" type="password" required />
              <small>Password requirements:</small>
              <ul>
                <li>At least 8 characters</li>
                <li>At least one uppercase letter (A-Z)</li>
                <li>At least one lowercase letter (a-z)</li>
                <li>At least one number (0-9)</li>
                <li>At least one special character (!@#$%^&*)</li>
              </ul>
            </div>

            <div class="form-group">
              <label for="confirmPassword">Confirm New Password</label>
              <input id="confirmPassword" name="confirmPassword" type="password" required />
            </div>
          </div>

          <button type="submit" id="changePasswordBtn">Change Password</button>
        </form>
        <div id="changePasswordStatus"></div>
      </section>

      <!-- Admin Section (only visible to admins) -->
      <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
        <section class="admin-section">
          <h3>Admin: User Management</h3>
          <p style="margin-bottom: 1.5rem; color: #64748b;">Manage all users in the system</p>

          <!-- Create New User Form -->
          <div class="form-section">
            <h4 style="font-size: 1rem; font-weight: 600; margin-bottom: 1rem;">Create New User</h4>
            <form id="createUserForm">
              <div class="form-group">
                <label for="newUsername">Username</label>
                <input id="newUsername" name="username" type="text" required />
                <small>3-50 characters, letters/numbers/underscore/hyphen only</small>
              </div>

              <div class="form-group">
                <label for="newEmail">Email</label>
                <input id="newEmail" name="email" type="email" required />
              </div>

              <div class="form-group">
                <label for="newFullName">Full Name (optional)</label>
                <input id="newFullName" name="fullName" type="text" />
              </div>

              <div class="form-group">
                <label for="newUserPassword">Password</label>
                <input id="newUserPassword" name="password" type="password" required />
                <small>Password requirements:</small>
                <ul>
                  <li>At least 8 characters</li>
                  <li>At least one uppercase letter (A-Z)</li>
                  <li>At least one lowercase letter (a-z)</li>
                  <li>At least one number (0-9)</li>
                  <li>At least one special character (!@#$%^&*)</li>
                </ul>
              </div>

              <div class="form-group">
                <label for="confirmNewUserPassword">Confirm Password</label>
                <input id="confirmNewUserPassword" name="confirmPassword" type="password" required />
              </div>

              <button type="submit" id="createUserBtn">Create User</button>
            </form>
            <div id="createUserStatus"></div>
          </div>

          <!-- Users List -->
          <div class="form-section">
            <h4 style="font-size: 1rem; font-weight: 600; margin-bottom: 1rem;">Current Users</h4>
            <div id="usersList">
              <p style="color: #64748b;">Loading users...</p>
            </div>
          </div>
        </section>
      <% } %>
    </div>
  </div>

  <script>
    // Fetch and populate user profile
    async function loadProfile() {
      try {
        const response = await fetch('/api/users/profile', {
          credentials: 'include',
        });
        const data = await response.json();

        if (data.status === 'success') {
          const user = data.user;
          document.getElementById('username').value = user.username;
          document.getElementById('email').value = user.email || '';
          document.getElementById('fullName').value = user.full_name || '';
          document.getElementById('accountStatus').value = user.status || 'active';

          // Store original data for comparison
          window.originalUser = user;
        } else {
          document.getElementById('profileStatus').innerHTML =
            `<p class="error">Failed to load profile: ${data.message}</p>`;
        }
      } catch (error) {
        document.getElementById('profileStatus').innerHTML =
          `<p class="error">Error loading profile: ${error.message}</p>`;
      }
    }

    // Update profile
    document.getElementById('profileForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      const email = document.getElementById('email').value;
      const fullName = document.getElementById('fullName').value;
      const statusDiv = document.getElementById('profileStatus');

      try {
        const response = await fetch('/api/users/profile', {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
          },
          credentials: 'include',
          body: JSON.stringify({ email, fullName }),
        });

        const data = await response.json();

        if (response.ok) {
          statusDiv.innerHTML = '<p class="success">Profile updated successfully!</p>';
          // Update original data
          window.originalUser = data.user;
        } else {
          statusDiv.innerHTML = `<p class="error">Update failed: ${data.message}</p>`;
        }
      } catch (error) {
        statusDiv.innerHTML = `<p class="error">Error: ${error.message}</p>`;
      }
    });

    // Change password handler
    document.getElementById('changePasswordForm').addEventListener('submit', async (e) => {
      e.preventDefault();

      const newPassword = document.getElementById('newPassword').value;
      const confirmPassword = document.getElementById('confirmPassword').value;
      const statusDiv = document.getElementById('passwordStatus');

      // Validate passwords match
      if (newPassword !== confirmPassword) {
        statusDiv.innerHTML = '<p class="error">Passwords do not match</p>';
        return;
      }

      try {
        const response = await fetch('/api/users/password', {
          method: 'PUT',
          headers: {
            'Content-Type': 'application/json',
          },
          credentials: 'include',
          body: JSON.stringify({ password: newPassword }),
        });

        const data = await response.json();

        if (response.ok) {
          statusDiv.innerHTML = '<p class="success">Password changed successfully!</p>';
          // Clear the form
          document.getElementById('changePasswordForm').reset();
          setTimeout(() => {
            statusDiv.innerHTML = '';
          }, 3000);
        } else {
          statusDiv.innerHTML = `<p class="error">Failed: ${data.message}</p>`;
        }
      } catch (error) {
        statusDiv.innerHTML = `<p class="error">Error: ${error.message}</p>`;
      }
    });

    // Load admin users list
    async function loadAdminUsersList() {
      const adminSection = document.querySelector('.admin-section');
      if (!adminSection) return; // Not admin

      try {
        const response = await fetch('/api/admin/users', {
          credentials: 'include',
        });
        const data = await response.json();

        if (data.status === 'success') {
          const usersList = document.getElementById('usersList');
          let html = '<table class="admin-users-table"><thead><tr>';
          html += '<th>Username</th><th>Email</th><th>Full Name</th><th>Status</th><th>Admin</th><th>Actions</th></tr></thead><tbody>';

          data.users.forEach((user) => {
            const isCurrentUser = window.currentUserId === user.user_id;
            const isAdmin = user.is_admin ? '✓' : '–';
            const status = user.status || 'active';
            const actionDisabled = isCurrentUser ? 'disabled' : '';

            html += `<tr>`;
            html += `<td>${user.username}</td>`;
            html += `<td>${user.email}</td>`;
            html += `<td>${user.full_name || '–'}</td>`;
            html += `<td><span class="status-badge ${status}">${status}</span></td>`;
            html += `<td>${isAdmin}</td>`;
            html += `<td>`;

            if (!isCurrentUser) {
              if (status === 'active') {
                html += `<button onclick="disableUser('${user.user_id}')">Disable</button>`;
              } else {
                html += `<button onclick="enableUser('${user.user_id}')">Enable</button>`;
              }
              html += `<button onclick="deleteUser('${user.user_id}', '${user.username}')" class="btn-danger">Delete</button>`;
            } else {
              html += '<span class="text-muted">Current User</span>';
            }

            html += `</td></tr>`;
          });

          html += '</tbody></table>';
          usersList.innerHTML = html;
        } else {
          document.getElementById('usersList').innerHTML =
            `<p class="error">Failed to load users: ${data.message}</p>`;
        }
      } catch (error) {
        document.getElementById('usersList').innerHTML =
          `<p class="error">Error loading users: ${error.message}</p>`;
      }
    }

    // Create new user handler
    if (document.getElementById('createUserForm')) {
      document.getElementById('createUserForm').addEventListener('submit', async (e) => {
        e.preventDefault();

        const username = document.getElementById('newUsername').value;
        const email = document.getElementById('newEmail').value;
        const fullName = document.getElementById('newFullName').value || null;
        const password = document.getElementById('newUserPassword').value;
        const confirmPassword = document.getElementById('confirmNewUserPassword').value;
        const statusDiv = document.getElementById('createUserStatus');

        // Validate passwords match
        if (password !== confirmPassword) {
          statusDiv.innerHTML = '<p class="error">Passwords do not match</p>';
          return;
        }

        try {
          const response = await fetch('/api/admin/users', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
            },
            credentials: 'include',
            body: JSON.stringify({ username, email, fullName, password }),
          });

          const data = await response.json();

          if (response.ok) {
            statusDiv.innerHTML = '<p class="success">User created successfully!</p>';
            // Clear the form
            document.getElementById('createUserForm').reset();
            // Reload users list
            setTimeout(() => {
              loadAdminUsersList();
              statusDiv.innerHTML = '';
            }, 1500);
          } else {
            statusDiv.innerHTML = `<p class="error">Failed: ${data.message}</p>`;
            if (data.errors) {
              data.errors.forEach((err) => {
                statusDiv.innerHTML += `<p class="error">• ${err}</p>`;
              });
            }
          }
        } catch (error) {
          statusDiv.innerHTML = `<p class="error">Error: ${error.message}</p>`;
        }
      });
    }

    // Admin actions
    async function disableUser(userId) {
      if (!confirm('Are you sure you want to disable this user?')) return;

      try {
        const response = await fetch(`/api/admin/users/${userId}/disable`, {
          method: 'POST',
        });

        const data = await response.json();

        if (response.ok) {
          alert('User disabled successfully');
          loadAdminUsersList();
        } else {
          alert(`Failed: ${data.message}`);
        }
      } catch (error) {
        alert(`Error: ${error.message}`);
      }
    }

    async function enableUser(userId) {
      if (!confirm('Are you sure you want to enable this user?')) return;

      try {
        const response = await fetch(`/api/admin/users/${userId}/enable`, {
          method: 'POST',
        });

        const data = await response.json();

        if (response.ok) {
          alert('User enabled successfully');
          loadAdminUsersList();
        } else {
          alert(`Failed: ${data.message}`);
        }
      } catch (error) {
        alert(`Error: ${error.message}`);
      }
    }

    async function deleteUser(userId, username) {
      if (!confirm(`Are you sure you want to DELETE user "${username}"? This action cannot be undone.`)) return;

      try {
        const response = await fetch(`/api/admin/users/${userId}`, {
          method: 'DELETE',
        });

        const data = await response.json();

        if (response.ok) {
          alert('User deleted successfully');
          loadAdminUsersList();
        } else {
          alert(`Failed: ${data.message}`);
        }
      } catch (error) {
        alert(`Error: ${error.message}`);
      }
    }

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', () => {
      loadProfile();
      loadAdminUsersList();
    });
  </script>
</main>
<%- include('partials/footer') %>
