<% if (isLoggedIn) { %>
  <div class="filter-panel">
    <div class="filter-header">
      <h3>📊 Study Filters</h3>
      <button class="filter-toggle" id="filter-toggle">
        <span class="toggle-icon">▼</span>
      </button>
    </div>
    
    <div class="filter-content hidden" id="filter-content">
      <div class="filter-row">
        <div class="filter-group">
          <label for="filter-class">Class:</label>
          <input
            type="text"
            id="filter-class"
            list="filter-class-options"
            placeholder="All classes"
            autocomplete="off"
          />
          <datalist id="filter-class-options"></datalist>
        </div>

        <div class="filter-group">
          <label for="filter-lesson">Lesson:</label>
          <input
            type="text"
            id="filter-lesson"
            list="filter-lesson-options"
            placeholder="All lessons"
            autocomplete="off"
          />
          <datalist id="filter-lesson-options"></datalist>
        </div>

        <div class="filter-group">
          <label for="filter-category">Category:</label>
          <input
            type="text"
            id="filter-category"
            list="filter-category-options"
            placeholder="All categories"
            autocomplete="off"
          />
          <datalist id="filter-category-options"></datalist>
        </div>

        <div class="filter-actions">
          <button class="btn btn-primary btn-sm" id="apply-filters">Apply Filters</button>
          <button class="btn btn-secondary btn-sm" id="clear-filters">Clear All</button>
        </div>
      </div>

      <div class="filter-status hidden" id="filter-status">
        <span id="active-filters"></span>
      </div>
    </div>
  </div>


  <script>
    // Helper function to escape HTML
    function escapeHtml(text) {
      const map = {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#039;',
      };
      return text.replace(/[&<>"']/g, (m) => map[m]);
    }

    // Filter state management
    let filterState = {
      class: null,
      lesson: null,
      category: null,
    };

    // Toggle filter panel visibility
    const filterToggle = document.getElementById('filter-toggle');
    const filterContent = document.getElementById('filter-content');

    filterToggle.addEventListener('click', () => {
      const isHidden = filterContent.classList.contains('hidden');
      filterContent.classList.toggle('hidden', !isHidden);
      filterToggle.classList.toggle('open', isHidden);
    });

    // Load filter options
    async function loadFilterOptions() {
      try {
        const [classRes, categoryRes] = await Promise.all([
          fetch('/api/entries/metadata/classes'),
          fetch('/api/entries/metadata/categories'),
        ]);

        const classData = await classRes.json();
        const categoryData = await categoryRes.json();

        if (classData.status === 'success' && classData.classes) {
          const classDatalist = document.getElementById('filter-class-options');
          classDatalist.innerHTML = classData.classes
            .map(cls => `<option value="${escapeHtml(cls)}" />`)
            .join('');
        }

        // Load all lessons initially (for when no class is selected)
        const lessonRes = await fetch('/api/entries/metadata/lessons');
        const lessonData = await lessonRes.json();
        if (lessonData.status === 'success' && lessonData.lessons) {
          const lessonDatalist = document.getElementById('filter-lesson-options');
          lessonDatalist.innerHTML = lessonData.lessons
            .map(lesson => `<option value="${escapeHtml(lesson)}" />`)
            .join('');
        }

        if (categoryData.status === 'success' && categoryData.categories) {
          const categoryDatalist = document.getElementById('filter-category-options');
          categoryDatalist.innerHTML = categoryData.categories
            .map(cat => `<option value="${escapeHtml(cat)}" />`)
            .join('');
        }
      } catch (error) {
        console.error('Error loading filter options:', error);
      }
    }

    // When class filter changes, filter lessons to show only lessons for that class
    const filterClassInput = document.getElementById('filter-class');
    filterClassInput.addEventListener('change', async () => {
      const selectedClass = filterClassInput.value;
      if (selectedClass) {
        try {
          const response = await fetch(`/api/entries/metadata/lessons/${encodeURIComponent(selectedClass)}`);
          const data = await response.json();
          if (data.status === 'success' && data.lessons) {
            const lessonDatalist = document.getElementById('filter-lesson-options');
            lessonDatalist.innerHTML = data.lessons
              .map(lesson => `<option value="${escapeHtml(lesson)}" />`)
              .join('');
            console.log('Filtered filter lessons for class', selectedClass, ':', data.lessons.length, 'items');
          }
        } catch (error) {
          console.error('Error loading lessons for class:', error);
        }
      } else {
        // If class is cleared, reload all lessons
        try {
          const response = await fetch('/api/entries/metadata/lessons');
          const data = await response.json();
          if (data.status === 'success' && data.lessons) {
            const lessonDatalist = document.getElementById('filter-lesson-options');
            lessonDatalist.innerHTML = data.lessons
              .map(lesson => `<option value="${escapeHtml(lesson)}" />`)
              .join('');
          }
        } catch (error) {
          console.error('Error loading all lessons:', error);
        }
      }
    });

    // Apply filters
    document.getElementById('apply-filters').addEventListener('click', () => {
      filterState.class = document.getElementById('filter-class').value || null;
      filterState.lesson = document.getElementById('filter-lesson').value || null;
      filterState.category = document.getElementById('filter-category').value || null;

      // Store in session/localStorage
      sessionStorage.setItem('studyFilters', JSON.stringify(filterState));

      // Update status display
      updateFilterStatus();

      // Dispatch custom event for other components to listen to
      window.dispatchEvent(new CustomEvent('filtersChanged', { detail: filterState }));

      console.log('Filters applied:', filterState);
    });

    // Clear filters
    document.getElementById('clear-filters').addEventListener('click', () => {
      filterState = { class: null, lesson: null, category: null };
      document.getElementById('filter-class').value = '';
      document.getElementById('filter-lesson').value = '';
      document.getElementById('filter-category').value = '';

      sessionStorage.setItem('studyFilters', JSON.stringify(filterState));
      updateFilterStatus();

      window.dispatchEvent(new CustomEvent('filtersChanged', { detail: filterState }));

      console.log('Filters cleared');
    });

    // Update filter status display
    function updateFilterStatus() {
      const statusDiv = document.getElementById('filter-status');
      const activeFilterSpan = document.getElementById('active-filters');

      const activeFilters = [];
      if (filterState.class) activeFilters.push(`Class: ${escapeHtml(filterState.class)}`);
      if (filterState.lesson) activeFilters.push(`Lesson: ${escapeHtml(filterState.lesson)}`);
      if (filterState.category) activeFilters.push(`Category: ${escapeHtml(filterState.category)}`);

      if (activeFilters.length > 0) {
        activeFilterSpan.textContent = `Active filters: ${activeFilters.join(' • ')}`;
        statusDiv.classList.remove('hidden');
      } else {
        statusDiv.classList.add('hidden');
      }
    }

    // Initialize on page load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', loadFilterOptions);
    } else {
      loadFilterOptions();
    }

    // Restore filters from session storage
    function restoreFilters() {
      const stored = sessionStorage.getItem('studyFilters');
      if (stored) {
        filterState = JSON.parse(stored);
        document.getElementById('filter-class').value = filterState.class || '';
        document.getElementById('filter-lesson').value = filterState.lesson || '';
        document.getElementById('filter-category').value = filterState.category || '';
        updateFilterStatus();
        // Dispatch event to notify other components (like practice.ejs) that filters have been restored
        window.dispatchEvent(new CustomEvent('filtersChanged', { detail: filterState }));
      }
    }

    restoreFilters();

    // Export filter state globally
    window.getStudyFilters = () => filterState;

    // Export filter refresh function globally
    window.refreshFilterOptions = loadFilterOptions;
  </script>
<% } %>
