<%- include('partials/header', { activePage: 'entries' }) %>
<main>
  <div class="entries-container">
    <h1>My Flashcards</h1>

    <% if (isLoggedIn) { %>
      <!-- Create New Entry Form -->
      <div class="entry-form-section">
        <h2>Create New Flashcard</h2>
        <form id="create-entry-form" class="entry-form">
          <div class="form-group">
            <label for="question">Question:</label>
            <textarea
              id="question"
              name="question"
              placeholder="Enter the question or front of the flashcard..."
              required
            ></textarea>
          </div>

          <div class="form-group">
            <label for="answer">Answer:</label>
            <textarea
              id="answer"
              name="answer"
              placeholder="Enter the answer or back of the flashcard..."
              required
            ></textarea>
          </div>

          <div class="form-group">
            <label for="question-type">Question Type:</label>
            <select id="question-type" name="questionType">
              <option value="standard">Standard (options generated from your cards)</option>
              <option value="true_false">True / False</option>
              <option value="multiple_choice">Multiple choice (provide your own options)</option>
              <option value="audio">Audio question (record, answer by choice)</option>
            </select>
            <small id="question-type-hint"></small>
          </div>

          <div class="form-group question-type-panel hidden" id="tf-toggle-panel">
            <label>Correct Answer:</label>
            <div class="tf-toggle" role="group" aria-label="True or False answer">
              <button type="button" id="tf-true-btn" class="tf-btn selected">True</button>
              <button type="button" id="tf-false-btn" class="tf-btn">False</button>
            </div>
          </div>

          <div class="form-group question-type-panel hidden" id="options-editor">
            <label>Answer Options:</label>
            <small>
              Mark each option correct or wrong. Options must be all text or all
              images (not a mix). All correct adds "All of the above"; all wrong
              adds "None of the above"; several correct plays as
              select-all-that-apply; otherwise it plays as authored.
            </small>
            <div id="options-rows"></div>
            <button type="button" class="btn btn-secondary" id="add-option-btn">+ Add Option</button>
          </div>

          <div class="form-group question-type-panel hidden" id="audio-recorder">
            <label>Question Audio:</label>
            <div class="audio-controls-row">
              <button type="button" class="btn btn-secondary" id="record-audio-btn">🎙️ Record</button>
              <button type="button" class="btn btn-secondary hidden" id="stop-audio-btn">⏹ Stop</button>
              <audio id="audio-preview" controls class="hidden"></audio>
              <button type="button" class="btn btn-danger hidden" id="clear-audio-btn">Clear</button>
            </div>
          </div>

          <div class="form-group">
            <label for="card-lang">Language (for text-to-speech and True/False labels):</label>
            <input type="text" id="card-lang" placeholder="en-US" list="lang-options" autocomplete="off" />
            <datalist id="lang-options">
              <option value="en-US"></option>
              <option value="es-ES"></option>
              <option value="fr-FR"></option>
              <option value="de-DE"></option>
              <option value="pt-BR"></option>
              <option value="it-IT"></option>
            </datalist>
          </div>

          <div class="form-group">
            <label for="card-answer-lang">Answer Language (optional, defaults to the question language):</label>
            <input type="text" id="card-answer-lang" placeholder="same as question" list="lang-options" autocomplete="off" />
          </div>

          <div class="form-group">
            <label for="answer-mode">Answer Mode:</label>
            <select id="answer-mode">
              <option value="choice">Choose from options</option>
              <option value="listen">Listen - say the answer aloud (pronunciation)</option>
            </select>
          </div>

          <div class="form-group">
            <label><input type="checkbox" id="question-tts" /> Read the question aloud (text + speech)</label>
            <label class="tts-answer-label"><input type="checkbox" id="answer-tts" /> Read the answer aloud (text + speech)</label>
          </div>

          <div class="form-group">
            <label for="question-image">Question Image (optional):</label>
            <input type="file" id="question-image" accept="image/*" />
            <img id="question-image-preview" class="media-preview hidden" alt="Question image preview" />
          </div>

          <div class="form-group">
            <label for="answer-image">Answer Image (optional):</label>
            <input type="file" id="answer-image" accept="image/*" />
            <img id="answer-image-preview" class="media-preview hidden" alt="Answer image preview" />
          </div>

          <div class="form-group">
            <label for="class">Class:</label>
            <input
              type="text"
              id="class"
              name="class"
              list="class-options"
              placeholder="Optional: e.g., Biology 101, AP Calculus"
              autocomplete="off"
            />
            <datalist id="class-options"></datalist>
          </div>

          <div class="form-group">
            <label for="lesson">Lesson (within Class):</label>
            <input
              type="text"
              id="lesson"
              name="lesson"
              list="lesson-options"
              placeholder="Optional: e.g., Lesson 5, Chapter 3"
              autocomplete="off"
            />
            <datalist id="lesson-options"></datalist>
          </div>

          <div class="form-group">
            <label for="category">Category (Independent):</label>
            <input
              type="text"
              id="category"
              name="category"
              list="category-options"
              placeholder="Optional: e.g., Taxonomy, Photosynthesis, Ecosystems"
              autocomplete="off"
            />
            <datalist id="category-options"></datalist>
          </div>

          <div class="form-group">
            <label for="is_private">
              <input
                type="checkbox"
                id="is_private"
                name="is_private"
                checked
              />
              Keep Private (not visible to other users)
            </label>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Create Flashcard</button>
            <span id="form-status"></span>
          </div>
        </form>
      </div>

      <!-- Entries List -->
      <div class="entries-list-section">
        <div class="entries-header">
          <h2>Your Flashcards</h2>
        </div>
        <p class="studyable-guideline">
          Guideline: each class + category group needs at least 4 cards (with distinct
          answers) for multiple-choice practice, and quizzes use at most 20 cards per run.
        </p>
        <div class="entries-header entries-header-flush">
          <div class="entries-actions">
            <label class="select-all-label">
              <input type="checkbox" id="select-all-entries" title="Select or clear all flashcards" />
              Select All
            </label>
            <button class="btn btn-primary" id="share-selected-btn" title="Share all checked flashcards">
              📤 Share Selected
            </button>
            <button class="btn btn-secondary" id="make-public-selected-btn" title="Make all checked flashcards public">
              🌐 Make Public
            </button>
            <button class="btn btn-secondary" id="make-private-selected-btn" title="Make all checked flashcards private">
              🔒 Make Private
            </button>
            <button class="btn btn-secondary" id="export-btn" title="Export all entries or filtered selection as a data JSON plus a linked media ZIP">
              📥 Export
            </button>
            <button class="btn btn-secondary" id="import-btn" title="Import entries from a data JSON (plus its linked media ZIP, selected together)">
              📤 Import
            </button>
            <input type="file" id="import-file-input" class="hidden" accept=".json,.zip" multiple />
          </div>
        </div>
        <div id="entries-list" class="entries-list">
          <p class="loading">Loading your flashcards...</p>
        </div>
      </div>

      <!-- Shared with Me Section -->
      <div class="shared-entries-section hidden">
        <h2>Shared with Me</h2>
        <div class="list-bulk-controls">
          <label>
            <input type="checkbox" id="select-all-shared" />
            Select All
          </label>
          <button type="button" class="btn btn-danger" id="remove-selected-shared-btn">Remove Selected</button>
        </div>
        <div id="shared-entries-list" class="entries-list">
          <p class="loading">Loading shared flashcards...</p>
        </div>
      </div>

      <!-- Public Cards Section -->
      <div class="public-entries-section hidden">
        <h2>Public Cards</h2>
        <p class="section-intro">
          Public cards from other users are automatically included in your practice
          and quizzes. Remove any you don't want to study.
        </p>
        <div class="list-bulk-controls">
          <label>
            <input type="checkbox" id="select-all-public" />
            Select All
          </label>
          <button type="button" class="btn btn-danger" id="remove-selected-public-btn">Remove Selected</button>
        </div>
        <div id="public-entries-list" class="entries-list">
          <p class="loading">Loading public cards...</p>
        </div>
        <details id="removed-public-details" class="removed-public-details hidden">
          <summary class="removed-public-summary">Removed public cards</summary>
          <div class="list-bulk-controls list-bulk-controls-spaced">
            <label>
              <input type="checkbox" id="select-all-removed" />
              Select All
            </label>
            <button type="button" class="btn btn-primary" id="restore-selected-btn">Restore Selected</button>
          </div>
          <div id="removed-public-list" class="entries-list entries-list-spaced"></div>
        </details>
      </div>

      <!-- Share Dialog -->
      <div id="share-dialog" class="share-dialog-overlay hidden">
        <div class="share-dialog">
          <h3>Share <span id="share-dialog-count">Flashcard</span></h3>
          <p>
            Pick users from the directory of public users, or type the exact
            usernames of users who are not listed. Separate multiple usernames
            with commas.
          </p>
          <div class="form-group">
            <label for="share-username">Username(s)</label>
            <input
              id="share-username"
              type="text"
              list="share-username-options"
              placeholder="user1, user2, ..."
              autocomplete="off"
            />
            <datalist id="share-username-options"></datalist>
          </div>
          <div class="share-dialog-actions">
            <button type="button" class="btn btn-primary" id="share-confirm-btn">Share</button>
            <button type="button" class="btn" id="share-cancel-btn">Cancel</button>
          </div>
          <div id="share-dialog-status"></div>
        </div>
      </div>

    <% } else { %>
      <p>Please <a href="/login">log in</a> to manage your flashcards.</p>
    <% } %>
  </div>

  <!-- Edit Modal -->
  <div id="edit-modal" class="modal hidden">
    <div class="modal-content">
      <div class="modal-header">
        <h2>Edit Flashcard</h2>
        <button class="modal-close" onclick="closeEditModal()">&times;</button>
      </div>
      <form id="edit-form" class="entry-form">
        <div class="form-group">
          <label for="edit-question">Question:</label>
          <textarea
            id="edit-question"
            name="question"
            placeholder="Enter the question or front of the flashcard..."
            required
          ></textarea>
        </div>

        <div class="form-group">
          <label for="edit-answer">Answer:</label>
          <textarea
            id="edit-answer"
            name="answer"
            placeholder="Enter the answer or back of the flashcard..."
            required
          ></textarea>
        </div>

        <div class="form-group">
          <label for="edit-question-type">Question Type:</label>
          <select id="edit-question-type">
            <option value="standard">Standard</option>
            <option value="true_false">True / False</option>
            <option value="multiple_choice">Multiple choice (own options)</option>
            <option value="audio">Audio question</option>
          </select>
        </div>

        <div class="form-group hidden" id="edit-tf-toggle-panel">
          <label>Correct Answer:</label>
          <div class="tf-toggle" role="group" aria-label="True or False answer">
            <button type="button" id="edit-tf-true-btn" class="tf-btn selected">True</button>
            <button type="button" id="edit-tf-false-btn" class="tf-btn">False</button>
          </div>
        </div>

        <div class="form-group hidden" id="edit-options-editor">
          <label>Answer Options:</label>
          <small>
            Mark each option correct or wrong. Options must be all text or all
            images (not a mix); several correct plays as select-all-that-apply.
          </small>
          <div id="edit-options-rows"></div>
          <button type="button" class="btn btn-secondary" id="edit-add-option-btn">+ Add Option</button>
        </div>

        <div class="form-group">
          <label for="edit-class">Class:</label>
          <input
            type="text"
            id="edit-class"
            name="class"
            list="edit-class-options"
            placeholder="Optional: e.g., Biology 101, AP Calculus"
            autocomplete="off"
          />
          <datalist id="edit-class-options"></datalist>
        </div>

        <div class="form-group">
          <label for="edit-lesson">Lesson (within Class):</label>
          <input
            type="text"
            id="edit-lesson"
            name="lesson"
            list="edit-lesson-options"
            placeholder="Optional: e.g., Lesson 5, Chapter 3"
            autocomplete="off"
          />
          <datalist id="edit-lesson-options"></datalist>
        </div>

        <div class="form-group">
          <label for="edit-category">Category (Independent):</label>
          <input
            type="text"
            id="edit-category"
            name="category"
            list="edit-category-options"
            placeholder="Optional: e.g., Taxonomy, Photosynthesis, Ecosystems"
            autocomplete="off"
          />
          <datalist id="edit-category-options"></datalist>
        </div>

        <div class="form-group">
          <label for="edit-is-private">
            <input
              type="checkbox"
              id="edit-is-private"
              name="is_private"
            />
            Keep Private (not visible to other users)
          </label>
        </div>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Save Changes</button>
          <button type="button" class="btn btn-secondary" onclick="closeEditModal()">Cancel</button>
          <span id="edit-form-status"></span>
        </div>
      </form>
    </div>
  </div>
</main>


<script>
  // Check if user is logged in
  const isLoggedIn = <%= isLoggedIn ? 'true' : 'false' %>;

  if (isLoggedIn) {
    document.addEventListener('DOMContentLoaded', async () => {
      await initializeEntriesPage();
    });
  }

  async function initializeEntriesPage() {
    await refreshAllMetadataOptions();
    setupCreateForm();
    loadUserEntries();
    loadSharedEntries();
    loadPublicEntries();
    
    // Listen for filter changes from the filter panel
    window.addEventListener('filtersChanged', () => {
      loadUserEntries();
      refreshAllMetadataOptions();
    });

    // Close modal when clicking outside of it
    window.addEventListener('click', (event) => {
      const modal = document.getElementById('edit-modal');
      if (event.target === modal) {
        closeEditModal();
      }
    });
  }

  async function refreshAllMetadataOptions() {
    // Refresh both create form and edit modal datalists
    await loadMetadataOptions();
    await loadEditMetadataOptions();
  }

  async function loadMetadataOptions() {
    try {
      // Load classes
      const classRes = await fetch('/api/entries/metadata/classes');
      const classData = await classRes.json();
      console.log('Classes response:', classData);
      if (classData.status === 'success' && classData.classes) {
        const classDatalist = document.getElementById('class-options');
        classDatalist.innerHTML = classData.classes
          .map(cls => `<option value="${escapeHtml(cls)}" />`)
          .join('');
        console.log('Populated classes datalist with', classData.classes.length, 'items');
      } else {
        console.warn('Classes response invalid:', classData);
      }

      // Load lessons
      const lessonRes = await fetch('/api/entries/metadata/lessons');
      const lessonData = await lessonRes.json();
      console.log('Lessons response:', lessonData);
      if (lessonData.status === 'success' && lessonData.lessons) {
        const lessonDatalist = document.getElementById('lesson-options');
        lessonDatalist.innerHTML = lessonData.lessons
          .map(lesson => `<option value="${escapeHtml(lesson)}" />`)
          .join('');
        console.log('Populated lessons datalist with', lessonData.lessons.length, 'items');
      } else {
        console.warn('Lessons response invalid:', lessonData);
      }

      // Load categories
      const categoryRes = await fetch('/api/entries/metadata/categories');
      const categoryData = await categoryRes.json();
      console.log('Categories response:', categoryData);
      if (categoryData.status === 'success' && categoryData.categories) {
        const categoryDatalist = document.getElementById('category-options');
        categoryDatalist.innerHTML = categoryData.categories
          .map(cat => `<option value="${escapeHtml(cat)}" />`)
          .join('');
        console.log('Populated categories datalist with', categoryData.categories.length, 'items');
      } else {
        console.warn('Categories response invalid:', categoryData);
      }
    } catch (error) {
      console.error('Error loading metadata options:', error);
    }
  }

  function setupCreateForm() {
    const form = document.getElementById('create-entry-form');
    const statusSpan = document.getElementById('form-status');
    const classInput = document.getElementById('class');

    // When class changes, filter lessons to show only lessons for that class
    classInput.addEventListener('change', async () => {
      const selectedClass = classInput.value;
      if (selectedClass) {
        try {
          const response = await fetch(`/api/entries/metadata/lessons/${encodeURIComponent(selectedClass)}`);
          const data = await response.json();
          if (data.status === 'success' && data.lessons) {
            const lessonDatalist = document.getElementById('lesson-options');
            lessonDatalist.innerHTML = data.lessons
              .map(lesson => `<option value="${escapeHtml(lesson)}" />`)
              .join('');
            console.log('Filtered lessons for class', selectedClass, ':', data.lessons.length, 'items');
          }
        } catch (error) {
          console.error('Error loading lessons for class:', error);
        }
      }
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const question = document.getElementById('question').value;
      const answer = document.getElementById('answer').value;
      const lesson = document.getElementById('lesson').value;
      const category = document.getElementById('category').value;
      const flashClass = document.getElementById('class').value;
      const is_private = document.getElementById('is_private').checked;

      const optionBlocks = collectOptionRows();
      if (optionFormsMixed(optionBlocks)) {
        statusSpan.textContent = 'Error: answer options must be all text or all images, not a mix.';
        statusSpan.className = 'error';
        return;
      }

      try {
        statusSpan.textContent = 'Creating...';
        statusSpan.className = '';

        const response = await fetch('/api/entries', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            question,
            answer,
            lesson,
            category,
            class: flashClass,
            is_private,
            questionType: document.getElementById('question-type').value,
            lang: document.getElementById('card-lang').value.trim() || 'en-US',
            answerLang: document.getElementById('card-answer-lang').value.trim() || null,
            answerMode: document.getElementById('answer-mode').value,
            questionBlock: buildBlock(
              mediaState.questionAudio,
              mediaState.questionImage,
              document.getElementById('question-tts').checked
            ),
            answerBlock: buildBlock(
              null,
              mediaState.answerImage,
              document.getElementById('answer-tts').checked
            ),
            options: optionBlocks,
          }),
        });

        const data = await response.json();

        if (data.status === 'success') {
          statusSpan.textContent = '✓ Flashcard created!';
          statusSpan.className = 'success';
          form.reset();
          document.getElementById('is_private').checked = true;

          // Reload entries and metadata options
          setTimeout(() => {
            loadUserEntries();
            refreshAllMetadataOptions();
            // Also refresh filter panel options
            if (window.refreshFilterOptions) {
              window.refreshFilterOptions().catch(err => {
                console.error('Error refreshing filter options:', err);
              });
            }
            statusSpan.textContent = '';
          }, 1000);
        } else {
          statusSpan.textContent = 'Error: ' + data.message;
          statusSpan.className = 'error';
        }
      } catch (error) {
        statusSpan.textContent = 'Error: ' + error.message;
        statusSpan.className = 'error';
      }
    });
  }

  /**
   * Render cards into collapsible groups nested by class -> lesson -> category.
   * A grouping level is only created when more than one distinct value exists
   * among the cards at that level (the "distinction" rule).
   */
  // Studyable guideline constants, matching the actual study model:
  // multiple choice needs 1 correct + 3 distinct wrong answers drawn from the
  // same class+category pool (lesson-independent), and a quiz uses at most 20
  // cards (larger pools are subset).
  const STUDYABLE_MIN = 4;
  const STUDYABLE_MAX = 20;

  function studyableChip(pool) {
    if (pool < 2) {
      return `<span class="studyable-chip not-studyable" title="Practice needs at least 2 cards with distinct answers in the same class + category to build any multiple choice question">✖ not studyable</span>`;
    }
    if (pool < STUDYABLE_MIN) {
      const needed = STUDYABLE_MIN - pool;
      return `<span class="studyable-chip needs-more" title="Playable with ${pool} cards, but full ${STUDYABLE_MIN}-option multiple choice needs ${STUDYABLE_MIN} cards with distinct answers in the same class + category">⚠️ add ${needed} for full choice</span>`;
    }
    if (pool > STUDYABLE_MAX) {
      return `<span class="studyable-chip large" title="A quiz uses at most ${STUDYABLE_MAX} cards; larger groups are subset - consider splitting into more lessons">${STUDYABLE_MAX}+ (quiz subsets)</span>`;
    }
    return `<span class="studyable-chip ok" title="Between ${STUDYABLE_MIN} and ${STUDYABLE_MAX} cards: fully studyable for multiple choice and quizzes">✓ studyable</span>`;
  }

  function renderGroupedEntries(cards, renderCard, levels) {
    const groupLevels = levels || ['class', 'lesson', 'category'];

    // Distractor pools are class+category wide (lesson-independent)
    const poolCounts = new Map();
    for (const card of cards) {
      const key = `${card.class || ''}||${card.category || ''}`;
      poolCounts.set(key, (poolCounts.get(key) || 0) + 1);
    }

    function chipFor(group) {
      const keys = [...new Set(group.map((card) => `${card.class || ''}||${card.category || ''}`))];
      if (keys.length !== 1) return '';
      return studyableChip(poolCounts.get(keys[0]) || 0);
    }

    function build(cardsAtLevel, levelIndex) {
      if (levelIndex >= groupLevels.length) {
        return cardsAtLevel.map(renderCard).join('');
      }

      const field = groupLevels[levelIndex];
      const values = [...new Set(cardsAtLevel.map((card) => card[field] || ''))];

      if (values.length <= 1) {
        // No distinction at this level - skip to the next
        return build(cardsAtLevel, levelIndex + 1);
      }

      return values
        .sort((a, b) => a.localeCompare(b))
        .map((value) => {
          const group = cardsAtLevel.filter((card) => (card[field] || '') === value);
          const label = value || `(No ${field})`;
          return `
            <details class="entry-group" open>
              <summary class="entry-group-summary">
                <span class="entry-group-label">${escapeHtml(label)}</span>
                <span class="entry-group-meta">
                  ${chipFor(group)}
                  <span class="entry-group-count">${group.length} card${group.length === 1 ? '' : 's'}</span>
                </span>
              </summary>
              <div class="entry-group-body">
                ${build(group, levelIndex + 1)}
              </div>
            </details>
          `;
        })
        .join('');
    }

    // Single uniform group: surface the chip at the top of the list
    const topChip = chipFor(cards);
    const body = build(cards, 0);
    if (topChip && !body.includes('entry-group-summary')) {
      return `<div class="studyable-topline">${topChip}</div>` + body;
    }
    return body;
  }

  async function loadUserEntries() {
    const list = document.getElementById('entries-list');

    try {
      // Get current filters from header
      const filters = window.getStudyFilters ? window.getStudyFilters() : {};
      
      // Build query string from filters
      const queryParams = new URLSearchParams();
      if (filters.class) queryParams.append('class', filters.class);
      if (filters.lesson) queryParams.append('lesson', filters.lesson);
      if (filters.category) queryParams.append('category', filters.category);

      const url = `/api/entries${queryParams.toString() ? '?' + queryParams.toString() : ''}`;
      const response = await fetch(url);
      const data = await response.json();

      if (data.status === 'success' && data.entries && data.entries.length > 0) {
        list.innerHTML = renderGroupedEntries(data.entries, (entry) => `
          <div class="entry-card">
            <label class="entry-select-label" title="Select for batch share">
              <input type="checkbox" class="entry-select" data-flashcard-id="${entry.flashcard_id}" />
            </label>
            <div class="entry-content">
              ${entry.question_type && entry.question_type !== 'standard' ? `<span class="type-badge">${escapeHtml(entry.question_type.replace('_', ' '))}</span>` : ''}
              ${entry.answer_mode === 'listen' ? '<span class="type-badge">listen</span>' : ''}
              <div class="entry-question">${entry.question ? escapeHtml(entry.question) : '🔊 Audio question'}</div>
