  // Setup edit form submission
  const editForm = document.getElementById('edit-form');
  if (editForm) {
    const editClassInput = document.getElementById('edit-class');
    
    // When class changes, filter lessons to show only lessons for that class
    editClassInput.addEventListener('change', async () => {
      const selectedClass = editClassInput.value;
      if (selectedClass) {
        try {
          const response = await fetch(`/api/entries/metadata/lessons/${encodeURIComponent(selectedClass)}`);
          const data = await response.json();
          if (data.status === 'success' && data.lessons) {
            const lessonDatalist = document.getElementById('edit-lesson-options');
            lessonDatalist.innerHTML = data.lessons
              .map(lesson => `<option value="${escapeHtml(lesson)}" />`)
              .join('');
            console.log('Filtered edit lessons for class', selectedClass, ':', data.lessons.length, 'items');
          }
        } catch (error) {
          console.error('Error loading lessons for class:', error);
        }
      }
    });

    editForm.addEventListener('submit', async (e) => {
      e.preventDefault();

      const entryId = editForm.dataset.entryId;
      const statusSpan = document.getElementById('edit-form-status');

      const editOptionBlocks = [...document.querySelectorAll('#edit-options-rows .option-row')].map(
        (row) => ({
          text: row.querySelector('.option-text').value,
          isCorrect: row.querySelector('.option-correct').checked,
          form: row._optionMedia ? 'image' : 'text',
          media: row._optionMedia || undefined,
        })
      );
      if (optionFormsMixed(editOptionBlocks)) {
        statusSpan.textContent = 'Error: answer options must be all text or all images, not a mix.';
        statusSpan.className = 'error';
        return;
      }

      try {
        statusSpan.textContent = 'Saving...';
        statusSpan.className = '';

        const response = await fetch(`/api/entries/${entryId}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            question: document.getElementById('edit-question').value,
            answer: document.getElementById('edit-answer').value,
            class: document.getElementById('edit-class').value,
            lesson: document.getElementById('edit-lesson').value,
            category: document.getElementById('edit-category').value,
            is_private: document.getElementById('edit-is-private').checked,
            question_type: document.getElementById('edit-question-type').value,
            options: editOptionBlocks,
          }),
        });

        const data = await response.json();

        if (data.status === 'success') {
          statusSpan.textContent = '✓ Entry updated!';
          statusSpan.className = 'success';
          
          setTimeout(() => {
            closeEditModal();
            loadUserEntries();
            refreshAllMetadataOptions();
            // Also refresh filter panel options
            if (window.refreshFilterOptions) {
              window.refreshFilterOptions().catch(err => {
                console.error('Error refreshing filter options:', err);
              });
            }
          }, 1000);
        } else {
          statusSpan.textContent = 'Error: ' + data.message;
          statusSpan.className = 'error';
        }
      } catch (error) {
        statusSpan.textContent = 'Error: ' + error.message;
        statusSpan.className = 'error';
      }
    });
  }

