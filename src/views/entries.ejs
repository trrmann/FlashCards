  async function removeSelectedShared() {
    const ids = getSelectedSharedIds();
    if (ids.length === 0) {
      alert('Check at least one shared flashcard first');
      return;
    }
    if (!confirm(`Remove ${ids.length} shared flashcard(s) from your list? The share records are deleted and the owners may share them again.`))
      return;

    let done = 0;
    const failures = [];
    for (const shareId of ids) {
      try {
        const response = await fetch(`/api/entries/shares/${shareId}/reject`, {
          method: 'POST',
          credentials: 'include',
        });
        if (response.ok) done += 1;
        else failures.push((await response.json()).message);
      } catch (error) {
        failures.push(error.message);
      }
    }
    alert(`${done} removed${failures.length ? `; ${failures.length} failed` : ''}`);
    loadSharedEntries();
  }

