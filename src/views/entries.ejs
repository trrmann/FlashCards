<%- include('partials/header') %>
<main>
  <div class="entries-container">
    <h1>My Flashcards</h1>

    <% if (isLoggedIn) { %>
      <!-- Create New Entry Form -->
      <div class="entry-form-section">
        <h2>Create New Flashcard</h2>
        <form id="create-entry-form" class="entry-form">
          <div class="form-group">
            <label for="question">Question:</label>
            <textarea
              id="question"
              name="question"
              placeholder="Enter the question or front of the flashcard..."
              required
            ></textarea>
          </div>

          <div class="form-group">
            <label for="answer">Answer:</label>
            <textarea
              id="answer"
              name="answer"
              placeholder="Enter the answer or back of the flashcard..."
              required
            ></textarea>
          </div>

          <div class="form-group">
            <label for="class">Class:</label>
            <input
              type="text"
              id="class"
              name="class"
              list="class-options"
              placeholder="Optional: e.g., Biology 101, AP Calculus"
              value="English Connect"
              autocomplete="off"
            />
            <datalist id="class-options"></datalist>
          </div>

          <div class="form-group">
            <label for="lesson">Lesson (within Class):</label>
            <input
              type="text"
              id="lesson"
              name="lesson"
              list="lesson-options"
              placeholder="Optional: e.g., Lesson 5, Chapter 3"
              value="Week 01"
              autocomplete="off"
            />
            <datalist id="lesson-options"></datalist>
          </div>

          <div class="form-group">
            <label for="category">Category (Independent):</label>
            <input
              type="text"
              id="category"
              name="category"
              list="category-options"
              placeholder="Optional: e.g., Taxonomy, Photosynthesis, Ecosystems"
              value="vocabulary"
              autocomplete="off"
            />
            <datalist id="category-options"></datalist>
          </div>

          <div class="form-group">
            <label for="is_private">
              <input
                type="checkbox"
                id="is_private"
                name="is_private"
                checked
              />
              Keep Private (not visible to other users)
            </label>
          </div>

          <div class="form-actions">
            <button type="submit" class="btn btn-primary">Create Flashcard</button>
            <span id="form-status"></span>
          </div>
        </form>
      </div>

      <!-- Entries List -->
      <div class="entries-list-section">
        <div class="entries-header">
          <h2>Your Flashcards</h2>
          <div class="entries-actions">
            <button class="btn btn-secondary" id="export-btn" title="Export all entries or filtered selection">
              📥 Export
            </button>
            <button class="btn btn-secondary" id="import-btn" title="Import entries from JSON file">
              📤 Import
            </button>
            <input type="file" id="import-file-input" style="display: none;" accept=".json" />
          </div>
        </div>
        <div id="entries-list" class="entries-list">
          <p class="loading">Loading your flashcards...</p>
        </div>
      </div>

      <!-- Shared with Me Section -->
      <div class="shared-entries-section" style="display: none;">
        <h2>Shared with Me</h2>
        <div id="shared-entries-list" class="entries-list">
          <p class="loading">Loading shared flashcards...</p>
        </div>
      </div>

    <% } else { %>
      <p>Please <a href="/login">log in</a> to manage your flashcards.</p>
    <% } %>
  </div>
</main>

<style>
  .entries-container {
    max-width: 900px;
    margin: 0 auto;
    padding: 20px;
  }

  .entry-form-section,
  .entries-list-section,
  .shared-entries-section {
    background: #f9f9f9;
    border: 1px solid #ddd;
    border-radius: 8px;
    padding: 20px;
    margin-bottom: 20px;
  }

  .entries-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }

  .entries-header h2 {
    margin: 0;
  }

  .entries-actions {
    display: flex;
    gap: 10px;
  }

  .entries-actions .btn {
    padding: 8px 16px;
    font-size: 13px;
  }

  .entry-form {
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }

  .form-group label {
    font-weight: bold;
    font-size: 14px;
  }

  .form-group textarea,
  .form-group input[type="text"] {
    padding: 8px 12px;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-family: inherit;
    font-size: 14px;
    resize: vertical;
    min-height: 80px;
  }

  .form-group input[type="text"] {
    min-height: auto;
  }

  .form-group label input[type="checkbox"] {
    margin-right: 8px;
  }

  .form-actions {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .btn {
    padding: 10px 20px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 14px;
    font-weight: bold;
  }

  .btn-primary {
    background: #007bff;
    color: white;
  }

  .btn-primary:hover {
    background: #0056b3;
  }

  .btn-secondary {
    background: #6c757d;
    color: white;
  }

  .btn-secondary:hover {
    background: #545b62;
  }

  .btn-danger {
    background: #dc3545;
    color: white;
  }

  .btn-danger:hover {
    background: #c82333;
  }

  #form-status {
    font-size: 14px;
    padding-left: 10px;
  }

  #form-status.success {
    color: #28a745;
  }

  #form-status.error {
    color: #dc3545;
  }

  .entries-list {
    display: grid;
    gap: 15px;
  }

  .entry-card {
    background: white;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    padding: 15px;
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 15px;
  }

  .entry-content {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .entry-question {
    font-weight: bold;
    font-size: 15px;
    color: #333;
  }

  .entry-answer {
    color: #666;
    font-size: 14px;
    margin-left: 20px;
    padding-top: 5px;
    border-top: 1px solid #eee;
  }

  .entry-metadata {
    font-size: 12px;
    color: #999;
    font-style: italic;
    display: flex;
    flex-wrap: wrap;
    gap: 15px;
    margin-top: 5px;
  }

  .entry-metadata-item {
    display: flex;
    gap: 5px;
  }

  .entry-metadata-label {
    font-weight: bold;
    color: #666;
  }

  .entry-lesson {
    font-size: 12px;
    color: #999;
    font-style: italic;
  }

  .entry-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-end;
  }

  .entry-actions button {
    padding: 6px 12px;
    font-size: 12px;
    min-width: 80px;
  }

  .entry-badge {
    display: inline-block;
    background: #e9ecef;
    color: #495057;
    padding: 4px 8px;
    border-radius: 3px;
    font-size: 11px;
    font-weight: bold;
  }

  .entry-badge.private {
    background: #f8d7da;
    color: #721c24;
  }

  .entry-badge.shared {
    background: #d1ecf1;
    color: #0c5460;
  }

  .empty-state {
    text-align: center;
    padding: 40px 20px;
    color: #999;
  }

  .empty-state p {
    margin: 10px 0;
  }

  .loading {
    text-align: center;
    color: #999;
    padding: 20px;
  }

  .error {
    color: #dc3545;
    padding: 10px;
    background: #f8d7da;
    border: 1px solid #f5c6cb;
    border-radius: 4px;
    margin-bottom: 15px;
  }

  .success {
    color: #155724;
    padding: 10px;
    background: #d4edda;
    border: 1px solid #c3e6cb;
    border-radius: 4px;
    margin-bottom: 15px;
  }
</style>

<script>
  // Check if user is logged in
  const isLoggedIn = <%= isLoggedIn ? 'true' : 'false' %>;

  if (isLoggedIn) {
    document.addEventListener('DOMContentLoaded', () => {
      initializeEntriesPage();
    });
  }

  function initializeEntriesPage() {
    loadMetadataOptions();
    setupCreateForm();
    loadUserEntries();
    loadSharedEntries();
    
    // Listen for filter changes from the filter panel
    window.addEventListener('filtersChanged', () => {
      loadUserEntries();
      loadMetadataOptions();
    });
  }

  async function loadMetadataOptions() {
    try {
      // Load classes
      const classRes = await fetch('/api/entries/metadata/classes');
      const classData = await classRes.json();
      if (classData.status === 'success' && classData.classes) {
        const classDatalist = document.getElementById('class-options');
        classDatalist.innerHTML = classData.classes
          .map(cls => `<option value="${escapeHtml(cls)}" />`)
          .join('');
      }

      // Load lessons
      const lessonRes = await fetch('/api/entries/metadata/lessons');
      const lessonData = await lessonRes.json();
      if (lessonData.status === 'success' && lessonData.lessons) {
        const lessonDatalist = document.getElementById('lesson-options');
        lessonDatalist.innerHTML = lessonData.lessons
          .map(lesson => `<option value="${escapeHtml(lesson)}" />`)
          .join('');
      }

      // Load categories
      const categoryRes = await fetch('/api/entries/metadata/categories');
      const categoryData = await categoryRes.json();
      if (categoryData.status === 'success' && categoryData.categories) {
        const categoryDatalist = document.getElementById('category-options');
        categoryDatalist.innerHTML = categoryData.categories
          .map(cat => `<option value="${escapeHtml(cat)}" />`)
          .join('');
      }
    } catch (error) {
      console.error('Error loading metadata options:', error);
    }
  }

  function setupCreateForm() {
    const form = document.getElementById('create-entry-form');
    const statusSpan = document.getElementById('form-status');

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const question = document.getElementById('question').value;
      const answer = document.getElementById('answer').value;
      const lesson = document.getElementById('lesson').value;
      const category = document.getElementById('category').value;
      const flashClass = document.getElementById('class').value;
      const is_private = document.getElementById('is_private').checked;

      try {
        statusSpan.textContent = 'Creating...';
        statusSpan.className = '';

        const response = await fetch('/api/entries', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            question,
            answer,
            lesson,
            category,
            class: flashClass,
            is_private,
          }),
        });

        const data = await response.json();

        if (data.status === 'success') {
          statusSpan.textContent = '✓ Flashcard created!';
          statusSpan.className = 'success';
          form.reset();
          
          // Restore default values after reset
          document.getElementById('class').value = 'English Connect';
          document.getElementById('lesson').value = 'Week 01';
          document.getElementById('category').value = 'vocabulary';
          document.getElementById('is_private').checked = true;

          // Reload entries and metadata options
          setTimeout(() => {
            loadUserEntries();
            loadMetadataOptions();
            // Also refresh filter panel options
            if (window.refreshFilterOptions) {
              window.refreshFilterOptions().catch(err => {
                console.error('Error refreshing filter options:', err);
              });
            }
            statusSpan.textContent = '';
          }, 1000);
        } else {
          statusSpan.textContent = 'Error: ' + data.message;
          statusSpan.className = 'error';
        }
      } catch (error) {
        statusSpan.textContent = 'Error: ' + error.message;
        statusSpan.className = 'error';
      }
    });
  }

  async function loadUserEntries() {
    const list = document.getElementById('entries-list');

    try {
      // Get current filters from header
      const filters = window.getStudyFilters ? window.getStudyFilters() : {};
      
      // Build query string from filters
      const queryParams = new URLSearchParams();
      if (filters.class) queryParams.append('class', filters.class);
      if (filters.lesson) queryParams.append('lesson', filters.lesson);
      if (filters.category) queryParams.append('category', filters.category);

      const url = `/api/entries${queryParams.toString() ? '?' + queryParams.toString() : ''}`;
      const response = await fetch(url);
      const data = await response.json();

      if (data.status === 'success' && data.entries && data.entries.length > 0) {
        list.innerHTML = data.entries
          .map(
            (entry) => `
          <div class="entry-card">
            <div class="entry-content">
              <div class="entry-question">${escapeHtml(entry.question)}</div>
              <div class="entry-answer">
                <strong>Answer:</strong> ${escapeHtml(entry.answer)}
              </div>
              <div class="entry-metadata">
                ${
                  entry.class
                    ? `<div class="entry-metadata-item">
                        <span class="entry-metadata-label">Class:</span>
                        <span>${escapeHtml(entry.class)}</span>
                      </div>`
                    : ''
                }
                ${
                  entry.lesson
                    ? `<div class="entry-metadata-item">
                        <span class="entry-metadata-label">Lesson:</span>
                        <span>${escapeHtml(entry.lesson)}</span>
                      </div>`
                    : ''
                }
                ${
                  entry.category
                    ? `<div class="entry-metadata-item">
                        <span class="entry-metadata-label">Category:</span>
                        <span>${escapeHtml(entry.category)}</span>
                      </div>`
                    : ''
                }
              </div>
              <div>
                <span class="entry-badge ${entry.is_private ? 'private' : ''}">
                  ${entry.is_private ? '🔒 Private' : '🌐 Public'}
                </span>
              </div>
            </div>
            <div class="entry-actions">
              <button class="btn btn-secondary" onclick="editEntry('${entry.flashcard_id}')">
                Edit
              </button>
              <button class="btn btn-primary" onclick="shareEntry('${entry.flashcard_id}')">
                Share
              </button>
              <button class="btn btn-danger" onclick="deleteEntry('${entry.flashcard_id}')">
                Delete
              </button>
            </div>
          </div>
        `
          )
          .join('');
      } else {
        list.innerHTML =
          '<div class="empty-state"><p>No flashcards yet.</p><p>Create your first flashcard above!</p></div>';
      }
    } catch (error) {
      list.innerHTML = '<div class="error">Error loading flashcards: ' + error.message + '</div>';
    }
  }

  async function loadSharedEntries() {
    const section = document.querySelector('.shared-entries-section');
    const list = document.getElementById('shared-entries-list');

    try {
      const response = await fetch('/api/entries/shares/accepted');
      const data = await response.json();

      if (data.status === 'success' && data.shares && data.shares.length > 0) {
        section.style.display = 'block';
        list.innerHTML = data.shares
          .map(
            (share) => `
          <div class="entry-card">
            <div class="entry-content">
              <div class="entry-question">${escapeHtml(share.question)}</div>
              <div class="entry-answer">
                <strong>Answer:</strong> ${escapeHtml(share.answer)}
              </div>
              <div class="entry-lesson">
                Shared by: ${escapeHtml(share.owner_username || 'Unknown')}
              </div>
              <div class="entry-metadata">
                ${
                  share.class
                    ? `<div class="entry-metadata-item">
                        <span class="entry-metadata-label">Class:</span>
                        <span>${escapeHtml(share.class)}</span>
                      </div>`
                    : ''
                }
                ${
                  share.lesson
                    ? `<div class="entry-metadata-item">
                        <span class="entry-metadata-label">Lesson:</span>
                        <span>${escapeHtml(share.lesson)}</span>
                      </div>`
                    : ''
                }
                ${
                  share.category
                    ? `<div class="entry-metadata-item">
                        <span class="entry-metadata-label">Category:</span>
                        <span>${escapeHtml(share.category)}</span>
                      </div>`
                    : ''
                }
              </div>
            </div>
            <div class="entry-actions">
              <button class="btn btn-danger" onclick="rejectShare('${share.share_id}')">
                Remove
              </button>
            </div>
          </div>
        `
          )
          .join('');
      }
    } catch (error) {
      console.error('Error loading shared entries:', error);
    }
  }

  function editEntry(entryId) {
    alert('Edit feature coming soon!');
  }

  function shareEntry(entryId) {
    const username = prompt('Enter username to share with:');
    if (!username) return;

    fetch(`/api/entries/${entryId}/share`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ username }),
    })
      .then((res) => res.json())
      .then((data) => {
        if (data.status === 'success') {
          alert('Shared with ' + username);
          loadUserEntries();
        } else {
          alert('Error: ' + data.message);
        }
      })
      .catch((err) => alert('Error: ' + err.message));
  }

  async function deleteEntry(entryId) {
    if (!confirm('Are you sure you want to delete this flashcard?')) return;

    try {
      const response = await fetch(`/api/entries/${entryId}`, {
        method: 'DELETE',
      });

      const data = await response.json();

      if (data.status === 'success') {
        alert('Flashcard deleted');
        loadUserEntries();
      } else {
        alert('Error: ' + data.message);
      }
    } catch (error) {
      alert('Error: ' + error.message);
    }
  }

  async function rejectShare(shareId) {
    if (!confirm('Remove this shared flashcard from your list?')) return;

    try {
      const response = await fetch(`/api/entries/shares/${shareId}/reject`, {
        method: 'POST',
      });

      const data = await response.json();

      if (data.status === 'success') {
        alert('Removed from shared list');
        loadSharedEntries();
      } else {
        alert('Error: ' + data.message);
      }
    } catch (error) {
      alert('Error: ' + error.message);
    }
  }

  // Export entries
  const exportBtn = document.getElementById('export-btn');
  if (exportBtn) {
    exportBtn.addEventListener('click', async () => {
      try {
        // Get current filters
        const filters = window.getStudyFilters ? window.getStudyFilters() : {};
        
        // Build query string
        const queryParams = new URLSearchParams();
        if (filters.class) queryParams.append('class', filters.class);
        if (filters.lesson) queryParams.append('lesson', filters.lesson);
        if (filters.category) queryParams.append('category', filters.category);

        const url = `/api/entries/export${queryParams.toString() ? '?' + queryParams.toString() : ''}`;
        
        // Fetch the export data with credentials to include session cookie
        const response = await fetch(url, {
          credentials: 'include'
        });
        
        if (!response.ok) {
          const errorData = await response.json();
          alert('Error: ' + (errorData.message || 'Failed to export entries'));
          return;
        }

        // Get the JSON data
        const data = await response.json();

        // Create blob and download
        const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
        const downloadUrl = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = downloadUrl;
        link.download = `flashcards-${Date.now()}.json`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(downloadUrl);

        alert(`✓ Exported ${data.count} flashcards`);
      } catch (error) {
        console.error('Export error:', error);
        alert('Export failed: ' + error.message);
      }
    });
  }

  // Import entries
  const importBtn = document.getElementById('import-btn');
  const importFileInput = document.getElementById('import-file-input');
  
  if (importBtn) {
    importBtn.addEventListener('click', () => {
      importFileInput.click();
    });
  }

  if (importFileInput) {
    importFileInput.addEventListener('change', async (e) => {
      const file = e.target.files[0];
      if (!file) return;

      try {
        const fileContent = await file.text();
        const importData = JSON.parse(fileContent);

        if (!Array.isArray(importData.entries) && !Array.isArray(importData)) {
        alert('Invalid file format. Expected JSON with entries array.');
        return;
      }

      const entries = Array.isArray(importData) ? importData : importData.entries;

      if (entries.length === 0) {
        alert('No entries found in file.');
        return;
      }

      if (!confirm(`Import ${entries.length} flashcards? This will add them to your entries.`)) {
        return;
      }

      // Send import request
      const response = await fetch('/api/entries/import', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ entries }),
      });

      const data = await response.json();

      if (data.status === 'success') {
        const message = data.updated > 0 
          ? `✓ Imported ${data.count} flashcards (${data.created} new, ${data.updated} updated)`
          : `✓ Imported ${data.count} flashcards`;
        alert(message);
        loadUserEntries();
      } else {
        alert('Error: ' + data.message);
      }
    } catch (error) {
      alert('Import failed: ' + error.message);
    } finally {
      // Reset file input
      e.target.value = '';
    }
    });
  }

  function escapeHtml(text) {
    const map = {
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;',
    };
    return text.replace(/[&<>"']/g, (m) => map[m]);
  }
</script>

<%- include('partials/footer') %>
