  // --- Question type / media authoring state ---
  const mediaState = { questionImage: null, answerImage: null, questionAudio: null };
  let mediaRecorder = null;
  let audioChunks = [];

  function wireFileToState(inputId, previewId, stateKey, maxMB) {
    const input = document.getElementById(inputId);
    if (!input) return;
    input.addEventListener('change', () => {
      const file = input.files && input.files[0];
      const preview = document.getElementById(previewId);
      if (!file) {
        mediaState[stateKey] = null;
        preview.classList.add('hidden');
        return;
      }
      if (file.size > maxMB * 1024 * 1024) {
        alert(`File too large (max ${maxMB}MB)`);
        input.value = '';
        return;
      }
      const reader = new FileReader();
      reader.onload = () => {
        mediaState[stateKey] = reader.result; // data URL
        preview.src = reader.result;
        preview.classList.remove('hidden');
      };
      reader.readAsDataURL(file);
    });
  }

  function buildBlock(audioData, imageData, tts) {
    if (audioData) return { form: 'audio', media: audioData };
    if (imageData) return { form: 'image', media: imageData };
    if (tts) return { form: 'text_tts' };
    return { form: 'text' };
  }

  function collectOptionRows() {
    return [...document.querySelectorAll('#options-rows .option-row')].map((row) => ({
      text: row.querySelector('.option-text').value,
      isCorrect: row.querySelector('.option-correct').checked,
      form: row._optionMedia ? 'image' : 'text',
      media: row._optionMedia || undefined,
    }));
  }

  // Options must be homogeneous: all text or all images (matches the server rule)
  function optionFormsMixed(options) {
    const usable = options.filter((o) => (o.text && o.text.trim()) || o.media);
    const hasImage = usable.some((o) => o.media);
    const hasText = usable.some((o) => !o.media);
    return hasImage && hasText;
  }

  function makeOptionRow(text = '', isCorrect = false, form = 'text', media = null) {
    const row = document.createElement('div');
    row.className = 'option-row';
    row.innerHTML = `
      <input type="text" class="option-text" placeholder="Option text" />
      <label><input type="checkbox" class="option-correct" /> correct</label>
      <button type="button" class="btn btn-secondary option-image-btn" title="Use an image for this option">📷</button>
      <input type="file" class="option-image-input hidden" accept="image/*" />
      <img class="option-image-preview hidden" alt="Option image" />
      <button type="button" class="btn btn-danger option-image-clear hidden" title="Remove the image">🗑</button>
      <button type="button" class="btn btn-danger option-remove">✕</button>
    `;
    row.querySelector('.option-text').value = text;
    row.querySelector('.option-correct').checked = isCorrect;
    const imageInput = row.querySelector('.option-image-input');
    const preview = row.querySelector('.option-image-preview');
    const clearBtn = row.querySelector('.option-image-clear');
    const setOptionImage = (dataUrl) => {
      row._optionMedia = dataUrl || null;
      preview.src = dataUrl || '';
      preview.classList.toggle('hidden', !dataUrl);
      clearBtn.classList.toggle('hidden', !dataUrl);
    };
    row.querySelector('.option-image-btn').addEventListener('click', () => imageInput.click());
    imageInput.addEventListener('change', () => {
      const file = imageInput.files && imageInput.files[0];
      if (!file) return;
      if (file.size > 2 * 1024 * 1024) {
        alert('Option image too large (max 2MB)');
        imageInput.value = '';
        return;
      }
      const reader = new FileReader();
      reader.onload = () => setOptionImage(reader.result);
      reader.readAsDataURL(file);
    });
    clearBtn.addEventListener('click', () => {
      imageInput.value = '';
      setOptionImage(null);
    });
    row.querySelector('.option-remove').addEventListener('click', () => row.remove());
    if (form === 'image' && media) setOptionImage(media);
    return row;
  }

  function addOptionRow(text = '', isCorrect = false, form = 'text', media = null) {
    document
      .getElementById('options-rows')
      .appendChild(makeOptionRow(text, isCorrect, form, media));
  }

  function updateTypePanels() {
    const type = document.getElementById('question-type').value;
    document
      .getElementById('options-editor')
      .classList.toggle('hidden', !(type === 'multiple_choice' || type === 'audio'));
    document.getElementById('audio-recorder').classList.toggle('hidden', type !== 'audio');
    document.getElementById('tf-toggle-panel').classList.toggle('hidden', type !== 'true_false');
    // True/false answers come from the toggle, not the textarea
    const answerField = document.getElementById('answer');
    answerField.closest('.form-group').classList.toggle('hidden', type === 'true_false');
    answerField.required = type !== 'true_false';
    if (type === 'true_false') syncTrueFalseAnswer();
    // Audio questions live in the recording; the text becomes an optional caption
    const questionField = document.getElementById('question');
    const questionLabel = document.querySelector('label[for="question"]');
    if (type === 'audio') {
      questionLabel.textContent = 'Question caption (optional):';
      questionField.required = false;
      questionField.placeholder =
        'Optional caption shown (and read aloud) alongside the recorded audio...';
    } else {
      questionLabel.textContent = 'Question:';
      questionField.required = true;
      questionField.placeholder = 'Enter the question or front of the flashcard...';
    }
    const hint = document.getElementById('question-type-hint');
    hint.textContent =
      type === 'audio'
        ? 'The recording is the question. The caption text is optional and is shown with the audio if provided.'
        : '';
  }

  function syncTrueFalseAnswer() {
    const isTrue = document.getElementById('tf-true-btn').classList.contains('selected');
    document.getElementById('answer').value = isTrue ? 'True' : 'False';
  }

  function selectTrueFalse(isTrue) {
    document.getElementById('tf-true-btn').classList.toggle('selected', isTrue);
    document.getElementById('tf-false-btn').classList.toggle('selected', !isTrue);
    syncTrueFalseAnswer();
  }

  async function startRecording() {
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      audioChunks = [];
      mediaRecorder = new MediaRecorder(stream);
      mediaRecorder.ondataavailable = (e) => audioChunks.push(e.data);
      mediaRecorder.onstop = () => {
        const blob = new Blob(audioChunks, { type: mediaRecorder.mimeType || 'audio/webm' });
        const reader = new FileReader();
        reader.onload = () => {
          mediaState.questionAudio = reader.result;
          const preview = document.getElementById('audio-preview');
          preview.src = reader.result;
          preview.classList.remove('hidden');
          document.getElementById('clear-audio-btn').classList.remove('hidden');
        };
        reader.readAsDataURL(blob);
        stream.getTracks().forEach((track) => track.stop());
      };
      mediaRecorder.start();
      document.getElementById('record-audio-btn').classList.add('hidden');
      document.getElementById('stop-audio-btn').classList.remove('hidden');
    } catch (error) {
      alert('Microphone unavailable: ' + error.message);
    }
  }

  function stopRecording() {
    if (mediaRecorder && mediaRecorder.state !== 'inactive') mediaRecorder.stop();
    document.getElementById('record-audio-btn').classList.remove('hidden');
    document.getElementById('stop-audio-btn').classList.add('hidden');
  }

  function updateEditTypePanels() {
    const type = document.getElementById('edit-question-type').value;
    document
      .getElementById('edit-options-editor')
      .classList.toggle('hidden', !(type === 'multiple_choice' || type === 'audio'));
    document
      .getElementById('edit-tf-toggle-panel')
      .classList.toggle('hidden', type !== 'true_false');
    const answerField = document.getElementById('edit-answer');
    answerField.closest('.form-group').classList.toggle('hidden', type === 'true_false');
    if (type === 'true_false') syncEditTrueFalseAnswer();
  }

  function syncEditTrueFalseAnswer() {
    const isTrue = document.getElementById('edit-tf-true-btn').classList.contains('selected');
    document.getElementById('edit-answer').value = isTrue ? 'True' : 'False';
  }

  function selectEditTrueFalse(isTrue) {
    document.getElementById('edit-tf-true-btn').classList.toggle('selected', isTrue);
    document.getElementById('edit-tf-false-btn').classList.toggle('selected', !isTrue);
    syncEditTrueFalseAnswer();
  }

  function addEditOptionRow(text = '', isCorrect = false, form = 'text', media = null) {
    document
      .getElementById('edit-options-rows')
      .appendChild(makeOptionRow(text, isCorrect, form, media));
  }

  function getSelectedEntryIds() {
    return [...document.querySelectorAll('.entry-select:checked')].map(
      (checkbox) => checkbox.dataset.flashcardId
    );
  }

  function toggleSelectAllEntries(checked) {
    document.querySelectorAll('.entry-select').forEach((box) => {
      box.checked = checked;
    });
  }

  async function setVisibilityForSelected(isPrivate) {
    const ids = getSelectedEntryIds();
    if (ids.length === 0) {
      alert('Check at least one flashcard first');
      return;
    }
    const label = isPrivate ? 'private' : 'public';
    if (!confirm(`Make ${ids.length} selected flashcard(s) ${label}?`)) return;

    try {
      const response = await fetch('/api/entries/visibility-batch', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({ flashcardIds: ids, isPrivate }),
      });
      const data = await response.json();
      if (data.status === 'success') {
        let message = data.message;
        if (data.skipped > 0) message += ` (${data.skipped} skipped - not owned)`;
        alert(message);
        loadUserEntries();
      } else {
        alert('Error: ' + data.message);
      }
    } catch (error) {
      alert('Error: ' + error.message);
    }
  }

  function shareSelectedEntries() {
    const ids = getSelectedEntryIds();
    if (ids.length === 0) {
      alert('Check at least one flashcard to share');
      return;
    }
    openShareDialog(ids);
  }

  function closeShareDialog() {
    shareDialogEntryIds = [];
    document.getElementById('share-dialog').classList.add('hidden');
  }

  async function confirmShare() {
    const usernames = document
      .getElementById('share-username')
      .value.split(',')
      .map((name) => name.trim())
      .filter(Boolean);
    const statusDiv = document.getElementById('share-dialog-status');

    if (usernames.length === 0) {
      statusDiv.innerHTML = '<p class="error">Enter or select at least one username</p>';
      return;
    }

    try {
      const response = await fetch('/api/entries/share-batch', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify({
          flashcardIds: shareDialogEntryIds,
          recipientUsernames: usernames,
        }),
      });
      const data = await response.json();

      if (data.status === 'success') {
        let summary = data.message;
        if (data.unknownUsernames && data.unknownUsernames.length > 0) {
          summary += ' | Unknown users: ' + data.unknownUsernames.join(', ');
        }
        if (data.failures && data.failures.length > 0) {
          summary += ' | ' + data.failures.length + ' failure(s)';
        }
        closeShareDialog();
        alert(summary);
        loadUserEntries();
      } else {
        statusDiv.innerHTML = `<p class="error">${data.message}</p>`;
      }
    } catch (error) {
      statusDiv.innerHTML = `<p class="error">Error: ${error.message}</p>`;
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const confirmBtn = document.getElementById('share-confirm-btn');
    const cancelBtn = document.getElementById('share-cancel-btn');
    const shareSelectedBtn = document.getElementById('share-selected-btn');
    if (confirmBtn) confirmBtn.addEventListener('click', confirmShare);
    if (cancelBtn) cancelBtn.addEventListener('click', closeShareDialog);
    if (shareSelectedBtn) shareSelectedBtn.addEventListener('click', shareSelectedEntries);
    const selectAllBox = document.getElementById('select-all-entries');
    if (selectAllBox)
      selectAllBox.addEventListener('change', (e) => toggleSelectAllEntries(e.target.checked));
    const makePublicBtn = document.getElementById('make-public-selected-btn');
    if (makePublicBtn)
      makePublicBtn.addEventListener('click', () => setVisibilityForSelected(false));
    const makePrivateBtn = document.getElementById('make-private-selected-btn');
    if (makePrivateBtn)
      makePrivateBtn.addEventListener('click', () => setVisibilityForSelected(true));
    const selectAllShared = document.getElementById('select-all-shared');
    if (selectAllShared)
      selectAllShared.addEventListener('change', (e) =>
        document.querySelectorAll('.shared-select').forEach((box) => (box.checked = e.target.checked))
      );
    const removeSharedBtn = document.getElementById('remove-selected-shared-btn');
    if (removeSharedBtn) removeSharedBtn.addEventListener('click', removeSelectedShared);
    const selectAllPublic = document.getElementById('select-all-public');
    if (selectAllPublic)
      selectAllPublic.addEventListener('change', (e) =>
        document.querySelectorAll('.public-select').forEach((box) => (box.checked = e.target.checked))
      );
    const removePublicBtn = document.getElementById('remove-selected-public-btn');
    if (removePublicBtn) removePublicBtn.addEventListener('click', removeSelectedPublic);
    const selectAllRemoved = document.getElementById('select-all-removed');
    if (selectAllRemoved)
      selectAllRemoved.addEventListener('change', (e) =>
        document.querySelectorAll('.removed-select').forEach((box) => (box.checked = e.target.checked))
      );
    const restoreSelectedBtn = document.getElementById('restore-selected-btn');
    if (restoreSelectedBtn) restoreSelectedBtn.addEventListener('click', restoreSelectedPublic);
    const typeSelect = document.getElementById('question-type');
    if (typeSelect) {
      typeSelect.addEventListener('change', updateTypePanels);
      updateTypePanels();
      wireFileToState('question-image', 'question-image-preview', 'questionImage', 2);
      wireFileToState('answer-image', 'answer-image-preview', 'answerImage', 2);
      document.getElementById('add-option-btn').addEventListener('click', () => addOptionRow());
      document.getElementById('tf-true-btn').addEventListener('click', () => selectTrueFalse(true));
      document.getElementById('tf-false-btn').addEventListener('click', () => selectTrueFalse(false));
      const editType = document.getElementById('edit-question-type');
      if (editType) editType.addEventListener('change', updateEditTypePanels);
      document.getElementById('edit-tf-true-btn').addEventListener('click', () => selectEditTrueFalse(true));
      document.getElementById('edit-tf-false-btn').addEventListener('click', () => selectEditTrueFalse(false));
      const editAddOpt = document.getElementById('edit-add-option-btn');
      if (editAddOpt) editAddOpt.addEventListener('click', () => addEditOptionRow());
      document.getElementById('record-audio-btn').addEventListener('click', startRecording);
      document.getElementById('stop-audio-btn').addEventListener('click', stopRecording);
      document.getElementById('clear-audio-btn').addEventListener('click', () => {
        mediaState.questionAudio = null;
        document.getElementById('audio-preview').classList.add('hidden');
        document.getElementById('clear-audio-btn').classList.add('hidden');
      });
    }
  });

  async function deleteEntry(entryId) {
    if (!confirm('Are you sure you want to delete this flashcard?')) return;

    try {
      const response = await fetch(`/api/entries/${entryId}`, {
        method: 'DELETE',
      });

      const data = await response.json();

      if (data.status === 'success') {
        alert('Flashcard deleted');
        loadUserEntries();
      } else {
        alert('Error: ' + data.message);
      }
    } catch (error) {
      alert('Error: ' + error.message);
    }
  }

  async function rejectShare(shareId) {
    if (!confirm('Remove this shared flashcard from your list?')) return;

    try {
      const response = await fetch(`/api/entries/shares/${shareId}/reject`, {
        method: 'POST',
      });

      const data = await response.json();

      if (data.status === 'success') {
        alert('Removed from shared list');
        loadSharedEntries();
      } else {
        alert('Error: ' + data.message);
      }
    } catch (error) {
      alert('Error: ' + error.message);
    }
  }

  // Export entries
  const exportBtn = document.getElementById('export-btn');
  if (exportBtn) {
    exportBtn.addEventListener('click', async () => {
      try {
        // Get current filters
        const filters = window.getStudyFilters ? window.getStudyFilters() : {};

        // Build query string
        const queryParams = new URLSearchParams();
        if (filters.class) queryParams.append('class', filters.class);
        if (filters.lesson) queryParams.append('lesson', filters.lesson);
        if (filters.category) queryParams.append('category', filters.category);

        const url = `/api/entries/export${queryParams.toString() ? '?' + queryParams.toString() : ''}`;

        // Fetch the export data with credentials to include session cookie
        const response = await fetch(url, {
          credentials: 'include',
        });

        if (!response.ok) {
          let errorMessage = 'Failed to export entries';

          try {
            const errorData = await response.json();
            errorMessage = errorData.message || errorMessage;
          } catch {
            const fallbackText = await response.text();
            if (fallbackText) {
              errorMessage = fallbackText;
            }
          }

          alert('Error: ' + errorMessage);
          return;
        }

        // Get the JSON data
        const data = await response.json();

        // Create blob and download
        const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
        const downloadUrl = URL.createObjectURL(blob);
        const link = document.createElement('a');
        link.href = downloadUrl;
        link.download = `flashcards-${Date.now()}.json`;
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
        URL.revokeObjectURL(downloadUrl);

        // Two-file export: when the manifest lists media, download the
        // linked media ZIP alongside the data JSON
        if (Array.isArray(data.media) && data.media.length > 0) {
          const mediaUrl = `/api/entries/export/media${queryParams.toString() ? '?' + queryParams.toString() : ''}`;
          const mediaResponse = await fetch(mediaUrl, { credentials: 'include' });
          if (mediaResponse.ok) {
            const zipBlob = await mediaResponse.blob();
            const zipUrl = URL.createObjectURL(zipBlob);
            const zipLink = document.createElement('a');
            zipLink.href = zipUrl;
            zipLink.download = `flashcards-media-${Date.now()}.zip`;
            document.body.appendChild(zipLink);
            zipLink.click();
            document.body.removeChild(zipLink);
            URL.revokeObjectURL(zipUrl);
          }
          alert(`✓ Exported ${data.count} flashcards + ${data.media.length} media items (JSON + ZIP)`);
        } else {
          alert(`✓ Exported ${data.count} flashcards`);
        }
      } catch (error) {
        console.error('Export error:', error);
        alert('Export failed: ' + error.message);
      }
    });
  }

  // Import entries
  const importBtn = document.getElementById('import-btn');
  const importFileInput = document.getElementById('import-file-input');

  if (importBtn && importFileInput) {
    importBtn.addEventListener('click', () => {
      importFileInput.click();
    });
  }

  function fileToBase64(file) {
    return new Promise((resolve, reject) => {
      const reader = new FileReader();
      reader.onload = () => resolve(String(reader.result).split(',')[1]);
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
  }

  if (importFileInput) {
    importFileInput.addEventListener('change', async (e) => {
      const files = [...e.target.files];
      if (files.length === 0) return;

      try {
        // Two-file import: a data JSON plus its linked media ZIP
        const jsonFile = files.find((f) => f.name.toLowerCase().endsWith('.json'));
        const zipFile = files.find((f) => f.name.toLowerCase().endsWith('.zip'));

        if (!jsonFile) {
          alert('Select the data JSON file (optionally together with its media ZIP).');
          return;
        }

        const fileContent = await jsonFile.text();
        const importData = JSON.parse(fileContent);

        if (!importData || (!Array.isArray(importData.entries) && !Array.isArray(importData))) {
          alert('Invalid file format. Expected JSON with entries array.');
          return;
        }

        const entries = Array.isArray(importData) ? importData : importData.entries;

        if (entries.length === 0) {
          alert('No entries found in file.');
          return;
        }

        const mediaCount = Array.isArray(importData.media) ? importData.media.length : 0;
        if (mediaCount > 0 && !zipFile) {
          if (
            !confirm(
              `This export references ${mediaCount} media item(s) but no media ZIP was selected. ` +
                'Import text content only (media will be skipped)?'
            )
          ) {
            return;
          }
        } else if (
          !confirm(`Import ${entries.length} flashcards? This will add them to your entries.`)
        ) {
          return;
        }

        const payload = { entries };
        if (zipFile) payload.mediaArchive = await fileToBase64(zipFile);

        // Send import request
        const response = await fetch('/api/entries/import', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'include',
          body: JSON.stringify(payload),
        });

        const data = await response.json();

        if (data.status === 'success') {
          let message =
            data.updated > 0
              ? `✓ Imported ${data.count} flashcards (${data.created} new, ${data.updated} updated)`
              : `✓ Imported ${data.count} flashcards`;
          if (data.skippedMedia > 0) {
            message += ` — ${data.skippedMedia} media reference(s) skipped (no matching ZIP item)`;
          }
          alert(message);
          loadUserEntries();
        } else {
          alert('Error: ' + data.message);
        }
      } catch (error) {
        alert('Import failed: ' + error.message);
      } finally {
        // Reset file input
        e.target.value = '';
      }
    });
  }

  function escapeHtml(text) {
    const map = {
      '&': '&amp;',
      '<': '&lt;',
      '>': '&gt;',
      '"': '&quot;',
      "'": '&#039;',
    };
    return text.replace(/[&<>"']/g, (m) => map[m]);
  }
</script>

<%- include('partials/footer') %>
