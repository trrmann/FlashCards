  async function editEntry(entryId) {
    try {
      // Fetch the entry data
      const response = await fetch(`/api/entries/${entryId}`);
      const data = await response.json();

      if (data.status === 'success' && data.flashcard) {
        const entry = data.flashcard;
        
        // Populate the edit form
        document.getElementById('edit-question').value = entry.question || '';
        document.getElementById('edit-answer').value = entry.answer || '';
        document.getElementById('edit-class').value = entry.class || '';
        document.getElementById('edit-lesson').value = entry.lesson || '';
        document.getElementById('edit-category').value = entry.category || '';
        document.getElementById('edit-is-private').checked = entry.is_private !== false;
        
        // Store the entry ID for use when saving
        document.getElementById('edit-form').dataset.entryId = entryId;
        
        // Load metadata options for the datalists
        await loadEditMetadataOptions();
        
        // Show the modal
        document.getElementById('edit-modal').style.display = 'block';
      } else {
        alert('Error: ' + data.message);
      }
    } catch (error) {
      console.error('Error loading entry for edit:', error);
      alert('Error loading entry: ' + error.message);
    }
  }

