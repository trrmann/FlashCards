<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Practice Study - Leitner System</title>
    <link rel="stylesheet" href="/css/styles.css" />
    <style>
      .practice-container {
        max-width: 900px;
        margin: 2rem auto;
        padding: 0 1rem;
      }

      .dashboard {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        margin-bottom: 2rem;
      }

      .stats-card {
        background: #f5f5f5;
        border: 2px solid #ddd;
        border-radius: 8px;
        padding: 1.5rem;
        text-align: center;
      }

      .stats-card h3 {
        margin: 0 0 0.5rem 0;
        font-size: 0.9rem;
        color: #666;
        text-transform: uppercase;
        letter-spacing: 0.05em;
      }

      .stats-card .number {
        font-size: 2.5rem;
        font-weight: bold;
        color: #333;
        margin: 0.5rem 0;
      }

      .stats-card .label {
        font-size: 0.85rem;
        color: #999;
      }

      .practice-section {
        background: white;
        border: 1px solid #ddd;
        border-radius: 8px;
        padding: 2rem;
        margin-bottom: 2rem;
      }

      .practice-section h2 {
        margin-top: 0;
        border-bottom: 2px solid #f0f0f0;
        padding-bottom: 1rem;
      }

      .card-display {
        background: #f9f9f9;
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        padding: 2rem;
        margin: 2rem 0;
        text-align: center;
        min-height: 200px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        cursor: pointer;
        transition: all 0.3s ease;
      }

      .card-display:hover {
        background: #f0f0f0;
        border-color: #999;
      }

      .card-display.flipped {
        background: #e8f4f8;
        border-color: #0066cc;
      }

      .card-side {
        display: none;
      }

      .card-side.active {
        display: block;
      }

      .card-label {
        font-size: 0.85rem;
        color: #999;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 1rem;
      }

      .card-text {
        font-size: 1.5rem;
        font-weight: 500;
        color: #333;
        line-height: 1.6;
      }

      .click-hint {
        font-size: 0.8rem;
        color: #bbb;
        margin-top: 1rem;
        font-style: italic;
      }

      .button-group {
        display: flex;
        gap: 1rem;
        justify-content: center;
        margin-top: 2rem;
      }

      .button-group button {
        padding: 0.75rem 1.5rem;
        font-size: 1rem;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.3s ease;
      }

      .btn-correct {
        background: #28a745;
        color: white;
      }

      .btn-correct:hover {
        background: #218838;
      }

      .btn-incorrect {
        background: #dc3545;
        color: white;
      }

      .btn-incorrect:hover {
        background: #c82333;
      }

      .btn-skip {
        background: #6c757d;
        color: white;
      }

      .btn-skip:hover {
        background: #5a6268;
      }

      .schedule-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-top: 1rem;
      }

      .schedule-item {
        background: #f9f9f9;
        padding: 1rem;
        border-radius: 4px;
        border-left: 4px solid #0066cc;
      }

      .schedule-item h4 {
        margin: 0 0 0.5rem 0;
        font-size: 0.9rem;
        color: #666;
        text-transform: uppercase;
      }

      .schedule-item .due {
        font-size: 0.9rem;
        color: #333;
        margin-bottom: 0.5rem;
      }

      .schedule-item .count {
        font-size: 1.5rem;
        font-weight: bold;
        color: #0066cc;
      }

      .no-cards {
        text-align: center;
        padding: 2rem;
        color: #999;
      }

      .progress-bar {
        width: 100%;
        height: 8px;
        background: #e0e0e0;
        border-radius: 4px;
        margin-top: 0.5rem;
        overflow: hidden;
      }

      .progress-fill {
        height: 100%;
        background: #28a745;
        transition: width 0.3s ease;
      }

      .streak {
        display: inline-block;
        background: #ffc107;
        color: #333;
        padding: 0.5rem 1rem;
        border-radius: 20px;
        font-weight: bold;
        font-size: 0.9rem;
        margin-top: 1rem;
      }

      /* Multiple Choice Styles */
      .question-box {
        background: #f9f9f9;
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        padding: 2rem;
        margin: 2rem 0;
        text-align: center;
        min-height: 100px;
      }

      .question-text {
        font-size: 1.5rem;
        font-weight: bold;
        color: #333;
        line-height: 1.6;
      }

      .options-container {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
        margin: 2rem 0;
      }

      .option-button {
        padding: 1rem;
        border: 2px solid #ddd;
        background: white;
        border-radius: 8px;
        cursor: pointer;
        font-size: 1rem;
        text-align: left;
        transition: all 0.3s ease;
        font-weight: 500;
        color: #333;
      }

      .option-button:hover:not(:disabled) {
        border-color: #0066cc;
        background: #f0f7ff;
        transform: translateY(-2px);
        box-shadow: 0 2px 8px rgba(0, 102, 204, 0.2);
      }

      .option-button:disabled {
        cursor: not-allowed;
      }

      .option-button.selected {
        border-color: #0066cc;
        background: #0066cc;
        color: white;
      }

      .option-button.correct {
        border-color: #28a745;
        background: #28a745;
        color: white;
      }

      .option-button.incorrect {
        border-color: #dc3545;
        background: #dc3545;
        color: white;
      }

      .feedback-message {
        padding: 1rem;
        border-radius: 8px;
        margin: 1rem 0;
        font-weight: bold;
        text-align: center;
        font-size: 1.1rem;
      }

      .feedback-correct {
        background: #d4edda;
        border: 2px solid #28a745;
        color: #155724;
      }

      .feedback-incorrect {
        background: #f8d7da;
        border: 2px solid #dc3545;
        color: #721c24;
      }

      .feedback-hidden {
        display: none;
      }

      .btn-next {
        display: block;
        margin: 1.5rem auto 0;
        padding: 0.75rem 2rem;
        font-size: 1rem;
        background: #0066cc;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.3s ease;
      }

      .btn-next:hover {
        background: #0052a3;
      }

      @media (max-width: 768px) {
        .dashboard {
          grid-template-columns: 1fr 1fr;
        }

        .options-container {
          grid-template-columns: 1fr;
        }

        .button-group {
          flex-direction: column;
        }

        .button-group button {
          width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <nav>
      <ul>
        <li><a href="/">Home</a></li>
        <% if (isLoggedIn) { %>
        <li><a href="/entries">Entries</a></li>
        <li><a href="/practice" class="active">Practice</a></li>
        <li><a href="/quiz">Quiz</a></li>
        <li><a href="/profile">Profile</a></li>
        <li><a href="/api/auth/logout">Logout</a></li>
        <% } else { %>
        <li><a href="/login">Login</a></li>
        <% } %>
      </ul>
    </nav>

    <div class="practice-container">
      <h1>🎓 Practice Study - Leitner System</h1>

      <!-- Dashboard Stats -->
      <div class="dashboard">
        <div class="stats-card">
          <h3>Box 1</h3>
          <div class="number"><%= stats.box1 %></div>
          <div class="label">Daily Review</div>
        </div>
        <div class="stats-card">
          <h3>Box 2</h3>
          <div class="number"><%= stats.box2 %></div>
          <div class="label">Every 3 Days</div>
        </div>
        <div class="stats-card">
          <h3>Box 3</h3>
          <div class="number"><%= stats.box3 %></div>
          <div class="label">Weekly Review</div>
        </div>
        <div class="stats-card">
          <h3>Accuracy</h3>
          <div class="number"><%= stats.accuracy %>%</div>
          <div class="label"><%= stats.totalCorrect %>/<%= stats.totalAttempts %> Correct</div>
        </div>
      </div>

      <!-- Today's Summary -->
      <div class="practice-section">
        <h2>📊 Today's Progress</h2>
        <div class="stats-card">
          <h3>Cards Due Today</h3>
          <div class="number"><%= summary.dueTodayCount %></div>
          <div class="label"><%= summary.practiceAttempts %> Reviewed</div>
          <div class="progress-bar">
            <div
              class="progress-fill"
              style="width: <%= (summary.practiceAttempts / summary.dueTodayCount) * 100 %>%"
            ></div>
          </div>
          <% if (streak > 0) { %>
          <div class="streak">🔥 <%= streak %> Correct in a Row!</div>
          <% } %>
        </div>
      </div>

      <!-- Review Schedule -->
      <div class="practice-section">
        <h2>📅 Review Schedule</h2>
        <div class="schedule-grid">
          <div class="schedule-item">
            <h4>Box 1 - Daily</h4>
            <div class="due"><%= schedule.box1.due %></div>
            <div class="count"><%= schedule.box1.count %> cards</div>
          </div>
          <div class="schedule-item" style="border-left-color: #ffc107">
            <h4>Box 2 - Every 3 Days</h4>
            <div class="due"><%= schedule.box2.due %></div>
            <div class="count"><%= schedule.box2.count %> cards</div>
          </div>
          <div class="schedule-item" style="border-left-color: #28a745">
            <h4>Box 3 - Weekly</h4>
            <div class="due"><%= schedule.box3.due %></div>
            <div class="count"><%= schedule.box3.count %> cards</div>
          </div>
        </div>
      </div>

      <!-- Practice Card Area -->
      <div class="practice-section">
        <h2>🎯 Start Practicing</h2>
        <div id="practice-area">
          <% if (summary.dueTodayCount > 0) { %>
          <!-- Question Display -->
          <div class="question-box">
            <div class="question-text" id="question-text">Loading first card...</div>
          </div>

          <!-- Multiple Choice Options -->
          <div class="options-container" id="options-container">
            <!-- Will be populated by JavaScript -->
          </div>

          <!-- Feedback Message -->
          <div id="feedback-message" class="feedback-hidden"></div>

          <!-- Next Button (appears after answer) -->
          <button class="btn-next" id="next-button" onclick="loadNextCard()" style="display: none;">
            ⏭️ Next Card
          </button>
          <% } else { %>
          <div class="no-cards">
            <p>🎉 No cards due today!</p>
            <p>Come back tomorrow to continue your practice.</p>
          </div>
          <% } %>
        </div>
      </div>

      <!-- Statistics -->
      <div class="practice-section">
        <h2>📈 Statistics</h2>
        <div class="dashboard">
          <div class="stats-card">
            <h3>Total Correct</h3>
            <div class="number"><%= stats.totalCorrect %></div>
          </div>
          <div class="stats-card">
            <h3>Total Incorrect</h3>
            <div class="number"><%= stats.totalIncorrect %></div>
          </div>
          <div class="stats-card">
            <h3>Total Attempts</h3>
            <div class="number"><%= stats.totalAttempts %></div>
          </div>
          <div class="stats-card">
            <h3>Mastered Cards</h3>
            <div class="number"><%= stats.box3 %></div>
            <div class="label">In Box 3</div>
          </div>
        </div>
      </div>
    </div>

    <script>
      let currentCard = null;
      let currentOptions = null;
      let answered = false;

      // Load the first card when page loads
      document.addEventListener('DOMContentLoaded', async () => {
        const dueTodayCount = <%= summary.dueTodayCount %>;
        if (dueTodayCount > 0) {
          await loadNextCard();
        }
      });

      async function loadNextCard() {
        answered = false;
        document.getElementById('feedback-message').className = 'feedback-hidden';
        document.getElementById('next-button').style.display = 'none';

        try {
          const response = await fetch('/api/practice/next');
          const data = await response.json();

          if (data.card && data.options) {
            currentCard = data.card;
            currentOptions = data.options;

            // Display question
            document.getElementById('question-text').textContent = currentCard.question;

            // Display multiple choice options
            displayOptions();
          } else if (!data.card) {
            alert('No cards due today! Great job! 🎉');
            location.reload();
          } else {
            alert('Error loading card options');
          }
        } catch (error) {
          console.error('Error loading card:', error);
          alert('Error loading card');
        }
      }

      function displayOptions() {
        const container = document.getElementById('options-container');
        container.innerHTML = '';

        currentOptions.forEach((option, index) => {
          const button = document.createElement('button');
          button.className = 'option-button';
          button.textContent = option.text;
          button.onclick = () => selectOption(index);
          button.disabled = answered;
          container.appendChild(button);
        });
      }

      async function selectOption(optionIndex) {
        if (answered) return; // Prevent multiple answers
        answered = true;

        // Mark selected option
        const buttons = document.querySelectorAll('.option-button');
        buttons.forEach((btn) => {
          btn.disabled = true;
        });
        buttons[optionIndex].classList.add('selected');

        try {
          const response = await fetch('/api/practice/answer', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              flashcardId: currentCard.flashcard_id,
              selectedOptionIndex: optionIndex,
            }),
          });

          const data = await response.json();

          if (data.status === 'success') {
            // Show feedback
            const feedbackEl = document.getElementById('feedback-message');
            feedbackEl.textContent = data.message;
            feedbackEl.className = data.isCorrect
              ? 'feedback-message feedback-correct'
              : 'feedback-message feedback-incorrect';

            // Style correct/incorrect option
            if (data.isCorrect) {
              buttons[optionIndex].classList.remove('selected');
              buttons[optionIndex].classList.add('correct');
            } else {
              buttons[optionIndex].classList.remove('selected');
              buttons[optionIndex].classList.add('incorrect');

              // Highlight correct answer
              const correctIndex = currentOptions.findIndex((o) => o.isCorrect);
              buttons[correctIndex].classList.add('correct');
            }

            // Show next button
            document.getElementById('next-button').style.display = 'block';
          } else {
            alert('Error: ' + data.error);
          }
        } catch (error) {
          console.error('Error submitting answer:', error);
          alert('Error submitting answer');
        }
      }
    </script>
  </body>
</html>
