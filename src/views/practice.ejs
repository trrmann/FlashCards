<%- include('partials/header', { activePage: 'practice' }) %>


    <div class="practice-container">
      <h1>🎓 Practice Study - Leitner System</h1>

      <!-- Dashboard Stats -->
      <div class="dashboard">
        <div class="stats-card">
          <h3>Box 1</h3>
          <div class="number"><%= stats.box1 %></div>
          <div class="label">Daily Review</div>
        </div>
        <div class="stats-card">
          <h3>Box 2</h3>
          <div class="number"><%= stats.box2 %></div>
          <div class="label">Every 3 Days</div>
        </div>
        <div class="stats-card">
          <h3>Box 3</h3>
          <div class="number"><%= stats.box3 %></div>
          <div class="label">Weekly Review</div>
        </div>
        <div class="stats-card">
          <h3>Accuracy</h3>
          <div class="number"><%= stats.accuracy %>%</div>
          <div class="label"><%= stats.totalCorrect %>/<%= stats.totalAttempts %> Correct</div>
        </div>
      </div>

      <!-- Today's Summary -->
      <div class="practice-section">
        <h2>📊 Today's Progress</h2>
        <div class="stats-card">
          <h3>Cards Due Today</h3>
          <div class="number"><%= summary.dueTodayCount %></div>
          <div class="label"><%= summary.practiceAttempts %> Reviewed</div>
          <div class="progress-bar">
            <div
              class="progress-fill progress-w<%= Math.min(100, Math.max(0, Math.round(((summary.practiceAttempts / summary.dueTodayCount) * 100) / 5) * 5)) %>"
            ></div>
          </div>
          <% if (streak > 0) { %>
          <div class="streak">🔥 <%= streak %> Correct in a Row!</div>
          <% } %>
        </div>
      </div>

      <!-- Review Schedule -->
      <div class="practice-section">
        <h2>📅 Review Schedule</h2>
        <div class="schedule-grid">
          <div class="schedule-item">
            <h4>Box 1 - Daily</h4>
            <div class="due"><%= schedule.box1.due %></div>
            <div class="count"><%= schedule.box1.count %> cards</div>
          </div>
          <div class="schedule-item schedule-warn">
            <h4>Box 2 - Every 3 Days</h4>
            <div class="due"><%= schedule.box2.due %></div>
            <div class="count"><%= schedule.box2.count %> cards</div>
          </div>
          <div class="schedule-item schedule-ok">
            <h4>Box 3 - Weekly</h4>
            <div class="due"><%= schedule.box3.due %></div>
            <div class="count"><%= schedule.box3.count %> cards</div>
          </div>
        </div>
      </div>

      <!-- Practice Card Area -->
      <div class="practice-section">
        <h2>🎯 Start Practicing</h2>
        <div id="practice-area">
          <!-- Question Display -->
          <div class="question-box">
            <div class="question-tools">
              <button type="button" class="btn-tool hidden" id="tts-button" title="Read the question aloud">🔊 Listen</button>
              <button type="button" class="btn-tool hidden" id="voice-answer-button" title="Say the answer aloud to check your pronunciation">🎤 Say answer</button>
            </div>
            <img id="question-image" class="question-media-image hidden" alt="Question image" />
            <audio id="question-audio" controls class="question-media-audio hidden"></audio>
            <div class="question-text" id="question-text">Loading first card...</div>
            <div id="voice-feedback" class="hidden"></div>
          </div>

          <!-- Multiple Choice Options -->
          <div class="options-container" id="options-container">
            <!-- Will be populated by JavaScript -->
          </div>

          <!-- Feedback Message -->
          <div id="feedback-message" class="feedback-hidden"></div>

          <!-- Next Button (appears after answer) -->
          <button class="btn-next hidden" id="next-button" onclick="loadNextCard()">
            ⏭️ Next Card
          </button>

          <!-- Status messages (shown when no cards due) -->
          <div id="status-message"></div>
        </div>
      </div>

      <!-- Statistics -->
      <div class="practice-section">
        <h2>📈 Statistics</h2>
        <div class="dashboard">
          <div class="stats-card">
            <h3>Total Correct</h3>
            <div class="number"><%= stats.totalCorrect %></div>
          </div>
          <div class="stats-card">
            <h3>Total Incorrect</h3>
            <div class="number"><%= stats.totalIncorrect %></div>
          </div>
          <div class="stats-card">
            <h3>Total Attempts</h3>
            <div class="number"><%= stats.totalAttempts %></div>
          </div>
          <div class="stats-card">
            <h3>Mastered Cards</h3>
            <div class="number"><%= stats.box3 %></div>
            <div class="label">In Box 3</div>
          </div>
        </div>
      </div>
    </div>

    <script>
      let currentCard = null;
      let currentOptions = null;
      let answered = false;
      let catchUpMode = false;
      let sessionStartTime = null;
      let currentAttemptCount = 1;
      let currentTotalAttempts = 1;

      // Load the first card when page loads
      document.addEventListener('DOMContentLoaded', async () => {
        const ttsButton = document.getElementById('tts-button');
        if (ttsButton) ttsButton.addEventListener('click', speakQuestion);
        const voiceButton = document.getElementById('voice-answer-button');
        if (voiceButton) voiceButton.addEventListener('click', listenForAnswer);
        // Capture session start time for tracking repetitions
        sessionStartTime = new Date().toISOString();
        
        // Wait a brief moment for filter-panel to restore filters from sessionStorage
        await new Promise(resolve => setTimeout(resolve, 100));
        
        // Refresh stats with restored filters if any filters are active
        if (sessionStorage.getItem('studyFilters')) {
          console.log('[DOMContentLoaded] Filters restored from session, refreshing stats...');
          await refreshStatsForActiveFilters();
        }
        
        try {
          const dueTodayCount = <%= summary.dueTodayCount %>;
          const totalCards = <%= stats.total %>;
          const practiceArea = document.getElementById('practice-area');
          const statusMsg = document.getElementById('status-message');
          const questionBox = document.querySelector('.question-box');
          const optionsContainer = document.getElementById('options-container');
          const questionText = document.getElementById('question-text');
          
          if (totalCards === 0) {
            // No cards at all - direct to entries page
            practiceArea.innerHTML = `
              <h2>📚 No Questions Yet</h2>
              <p>You haven't added any flashcards yet. Get started by adding your first cards!</p>
              <a href="/entries" class="btn btn-primary cta-link">Go to Entries</a>
            `;
          } else if (dueTodayCount > 0) {
            // Show card area and load first card
            questionBox.classList.remove('hidden');
            optionsContainer.classList.remove('hidden');
            statusMsg.classList.add('hidden');
            await loadNextCard();
          } else {
            // Cards exist but none due - offer catch-up option
            questionBox.classList.add('hidden');
            optionsContainer.classList.add('hidden');
            statusMsg.innerHTML = `
              <h2>🎉 Great Job!</h2>
              <p>No cards are due for study today. You're all caught up!</p>
              <button onclick="startCatchUpMode()" class="cta-button cta-success">
                📚 Practice More (Catch-up Mode)
              </button>
            `;
            statusMsg.classList.remove('hidden');
          }
        } catch (error) {
          console.error('Error initializing practice page:', error);
          const statusMsg = document.getElementById('status-message');
          if (statusMsg) {
            statusMsg.innerHTML = '<h2>Error</h2><p>Failed to load practice page. Please refresh.</p>';
            statusMsg.classList.remove('hidden');
          }
        }
      });

      async function startCatchUpMode() {
        catchUpMode = true;
        console.log('[startCatchUpMode] Entering catch-up practice mode');
        // Show card area
        document.querySelector('.question-box').classList.remove('hidden');
        document.getElementById('options-container').classList.remove('hidden');
        document.getElementById('status-message').classList.add('hidden');
        await loadNextCard();
      }

      /**
       * Refresh dashboard stats based on active filters
       */
      async function refreshStatsForActiveFilters() {
        try {
          // Get active filters from sessionStorage
          const studyFiltersJson = sessionStorage.getItem('studyFilters');
          const filters = studyFiltersJson ? JSON.parse(studyFiltersJson) : {};

          // Build URL with filter parameters
          let url = '/api/practice/stats';
          if (filters.class) url += `?class=${encodeURIComponent(filters.class)}`;
          if (filters.lesson) url += `${filters.class ? '&' : '?'}lesson=${encodeURIComponent(filters.lesson)}`;
          if (filters.category) url += `${filters.class || filters.lesson ? '&' : '?'}category=${encodeURIComponent(filters.category)}`;

          console.log('[refreshStatsForActiveFilters] Fetching stats from ' + url);

          const response = await fetch(url, {
            credentials: 'include',
          });

          if (!response.ok) {
            console.error('[refreshStatsForActiveFilters] Error:', response.status);
            return;
          }

          const data = await response.json();
          if (data.status === 'success' && data.stats) {
            // Update the dashboard stats (box counts and accuracy)
            const dashboardCards = document.querySelectorAll('.dashboard:first-of-type .stats-card .number');
            if (dashboardCards.length >= 3) {
              dashboardCards[0].textContent = data.stats.box1;
              dashboardCards[1].textContent = data.stats.box2;
              dashboardCards[2].textContent = data.stats.box3;
            }

            // Also update accuracy (4th card in dashboard)
            if (dashboardCards.length >= 4) {
              dashboardCards[3].textContent = data.stats.accuracy + '%';
              const accuracyLabel = dashboardCards[3].parentElement.querySelector('.label');
              if (accuracyLabel) {
                accuracyLabel.textContent = `${data.stats.totalCorrect}/${data.stats.totalAttempts} Correct`;
              }
            }

            // Update the statistics section (total correct/incorrect/attempts)
            const allDashboards = document.querySelectorAll('.dashboard');
            if (allDashboards.length > 1) {
              const statisticsDashboard = allDashboards[1];
              const statCards = statisticsDashboard.querySelectorAll('.stats-card .number');
              if (statCards.length >= 3) {
                statCards[0].textContent = data.stats.totalCorrect;
                statCards[1].textContent = data.stats.totalIncorrect;
                statCards[2].textContent = data.stats.totalAttempts;
                if (statCards.length >= 4) {
                  statCards[3].textContent = data.stats.box3;
                }
              }
            }

            console.log(
              `[refreshStatsForActiveFilters] Updated stats: box1=${data.stats.box1}, box2=${data.stats.box2}, box3=${data.stats.box3}, accuracy=${data.stats.accuracy}%, totalCorrect=${data.stats.totalCorrect}, totalAttempts=${data.stats.totalAttempts}`
            );
          }

          // Also fetch and update summary (Cards Due Today, etc.)
          let summaryUrl = '/api/practice/summary';
          if (filters.class) summaryUrl += `?class=${encodeURIComponent(filters.class)}`;
          if (filters.lesson) summaryUrl += `${filters.class ? '&' : '?'}lesson=${encodeURIComponent(filters.lesson)}`;
          if (filters.category) summaryUrl += `${filters.class || filters.lesson ? '&' : '?'}category=${encodeURIComponent(filters.category)}`;

          const summaryResponse = await fetch(summaryUrl, {
            credentials: 'include',
          });

          if (summaryResponse.ok) {
            const summaryData = await summaryResponse.json();
            if (summaryData.status === 'success' && summaryData.summary) {
              const summary = summaryData.summary;
              // Find the "Cards Due Today" card and update it
              const allCards = document.querySelectorAll('.stats-card');
              allCards.forEach(card => {
                const h3 = card.querySelector('h3');
                if (h3 && h3.textContent === 'Cards Due Today') {
                  const numberDiv = card.querySelector('.number');
                  const labelDiv = card.querySelector('.label');
                  if (numberDiv) numberDiv.textContent = summary.dueTodayCount;
                  if (labelDiv) labelDiv.textContent = `${summary.practiceAttempts} Reviewed`;
                  // Update progress bar
                  const progressFill = card.querySelector('.progress-fill');
                  if (progressFill) {
                    const percentage = summary.dueTodayCount > 0 
                      ? (summary.practiceAttempts / summary.dueTodayCount) * 100 
                      : 0;
                    progressFill.className = `progress-fill progress-w${Math.min(100, Math.max(0, Math.round(percentage / 5) * 5))}`;
                  }
                }
              });
              console.log('[refreshStatsForActiveFilters] Updated summary: due=' + summary.dueTodayCount + ', attempts=' + summary.practiceAttempts);
            }
          }
        } catch (error) {
          console.error('[refreshStatsForActiveFilters] Error:', error);
        }
      }

      // Listen for filter changes from the filter panel
      window.addEventListener('filtersChanged', async () => {
        console.log('[filtersChanged event] Filters changed, refreshing stats...');
        await refreshStatsForActiveFilters();
        // Optionally reload the current card if filters changed
        await loadNextCard();
      });

      function renderQuestionMedia(card) {
        const image = document.getElementById('question-image');
        if (card.question_form === 'image' && card.question_media_data) {
          image.src = card.question_media_data;
          image.classList.remove('hidden');
        } else {
          image.classList.add('hidden');
        }

        const audio = document.getElementById('question-audio');
        if (card.question_form === 'audio' && card.question_media_data) {
          audio.src = card.question_media_data;
          audio.classList.remove('hidden');
        } else {
          audio.classList.add('hidden');
        }

        // TTS read-aloud (Web Speech API - no server, no keys)
        const ttsButton = document.getElementById('tts-button');
        ttsButton.classList.toggle('hidden', !('speechSynthesis' in window && card.question));

        // Voice answer (SpeechRecognition - Chrome/Edge/Safari)
        const voiceButton = document.getElementById('voice-answer-button');
        const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
        voiceButton.classList.toggle('hidden', !SpeechRec);
        document.getElementById('voice-feedback').classList.add('hidden');
      }

      function speakQuestion() {
        if (!currentCard || !('speechSynthesis' in window)) return;
        window.speechSynthesis.cancel();
        const utterance = new SpeechSynthesisUtterance(currentCard.question);
        if (currentCard.lang) utterance.lang = currentCard.lang;
        window.speechSynthesis.speak(utterance);
      }

      function normalizeSpeech(text) {
        return String(text || '')
          .toLowerCase()
          .replace(/[^a-z0-9 ]/g, ' ')
          .replace(/\s+/g, ' ')
          .trim();
      }

      async function submitListenResult(isCorrect) {
        answered = true;
        try {
          await fetch('/api/practice/answer', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',
            body: JSON.stringify({
              flashcardId: currentCard.flashcard_id,
              selectedAnswer: currentCard.answer,
              isCorrect,
              sessionStartTime,
            }),
          });
          const nextBtn = document.getElementById('next-button');
          nextBtn.classList.remove('hidden');
          await refreshStatsForActiveFilters();
        } catch (error) {
          console.error('listen submit failed', error);
        }
      }

      function listenForAnswer() {
        const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
        if (!SpeechRec) return;
        const feedback = document.getElementById('voice-feedback');
        feedback.classList.remove('hidden');
        feedback.textContent = '🎤 Listening…';

        const recognition = new SpeechRec();
        recognition.lang =
          (currentCard && (currentCard.answer_lang || currentCard.lang)) || 'en-US';
        recognition.interimResults = false;
        recognition.maxAlternatives = 3;

        recognition.onresult = (event) => {
          const alternatives = [...event.results[0]].map((alt) => normalizeSpeech(alt.transcript));
          const correct =
            currentCard && currentCard.answer_mode === 'listen'
              ? { text: currentCard.answer }
              : (currentOptions || []).find((option) => option.isCorrect);
          const correctText = normalizeSpeech(correct ? correct.text : '');
          const heard = alternatives[0] || '';
          const matched = alternatives.some(
            (alt) => alt === correctText || (correctText && alt.includes(correctText))
          );

          if (matched) {
            if (currentCard && currentCard.answer_mode === 'listen') {
              feedback.innerHTML = `✅ Pronunciation correct: "<em>${heard}</em>"`;
              if (!answered) submitListenResult(true);
            } else {
              feedback.innerHTML = `✅ Pronunciation recognized: "<em>${heard}</em>" — selecting the matching answer.`;
              const index = currentOptions.findIndex((option) => option.isCorrect);
              if (index >= 0 && !answered) selectOption(index);
            }
          } else {
            feedback.innerHTML = `❌ Heard "<em>${heard}</em>" — expected "<em>${correct ? correct.text : ''}</em>". Try again.`;
          }
        };
        recognition.onerror = (event) => {
          feedback.textContent = 'Speech recognition error: ' + event.error;
        };
        recognition.start();
      }

      async function loadNextCard() {
        answered = false;
        const statusMsg = document.getElementById('status-message');
        const feedbackEl = document.getElementById('feedback-message');
        const nextBtn = document.getElementById('next-button');
        if (feedbackEl) feedbackEl.className = 'feedback-hidden';
        if (nextBtn) nextBtn.classList.add('hidden');

        try {
          // Get active filters from sessionStorage
          const studyFiltersJson = sessionStorage.getItem('studyFilters');
          const filters = studyFiltersJson ? JSON.parse(studyFiltersJson) : {};
          
          // Build URL with filter parameters
          let url = catchUpMode ? '/api/practice/next?catchUp=true' : '/api/practice/next';
          
          // Track if we already have query parameters
          let hasQueryParams = catchUpMode;
          
          // Add filter parameters if they exist
          if (filters.class) {
            url += hasQueryParams ? '&' : '?';
            url += `class=${encodeURIComponent(filters.class)}`;
            hasQueryParams = true;
          }
          if (filters.lesson) {
            url += hasQueryParams ? '&' : '?';
            url += `lesson=${encodeURIComponent(filters.lesson)}`;
            hasQueryParams = true;
          }
          if (filters.category) {
            url += hasQueryParams ? '&' : '?';
            url += `category=${encodeURIComponent(filters.category)}`;
            hasQueryParams = true;
          }
          
          console.log('[loadNextCard] Fetching ' + url + '...');
          
          // Add timeout to fetch
          const controller = new AbortController();
          const timeoutId = setTimeout(() => controller.abort(), 10000); // 10 second timeout
          
          const response = await fetch(url, { 
            signal: controller.signal,
            credentials: 'include'  // Important: send cookies with request
          });
          clearTimeout(timeoutId);
          
          console.log('[loadNextCard] Response status:', response.status);
          
          if (!response.ok) {
            throw new Error(`HTTP ${response.status}: ${response.statusText}`);
          }
          
          const data = await response.json();
          console.log('[loadNextCard] Data received:', data);

          if (data.card && data.options) {
            currentCard = data.card;
            currentOptions = data.options;

            // Display question (audio questions may have no caption text)
            const questionTextEl = document.getElementById('question-text');
            questionTextEl.textContent = currentCard.question || '';
            questionTextEl.classList.toggle('hidden', !currentCard.question);
            renderQuestionMedia(currentCard);

            // Display multiple choice options
            displayOptions();
          } else if (data.insufficientEntries) {
            // Not enough entries to create multiple choice options
            const questionBox = document.querySelector('.question-box');
            const optionsContainer = document.getElementById('options-container');

            questionBox.classList.add('hidden');
            optionsContainer.classList.add('hidden');
            statusMsg.classList.remove('hidden');

            let diagnosticHTML = '';
            if (data.diagnostic) {
              const d = data.diagnostic;
              diagnosticHTML = `
                <details class="missing-entries">
                  <summary class="missing-entries-summary">📋 What entries are missing?</summary>
                  <div class="missing-entries-body">
                    <p><strong>Current Card:</strong> ${d.currentCard.question}</p>
                    <p><strong>Class:</strong> ${d.currentCard.class}</p>
                    <p><strong>Category:</strong> ${d.currentCard.category}</p>
                    <p><strong>Lesson:</strong> ${d.currentCard.lesson}</p>
                    <hr class="missing-entries-divider">
                    <p><strong>Available wrong answers:</strong> ${d.availableWrongAnswers}</p>
                    <p><strong>More needed:</strong> ${d.neededWrongAnswers}</p>
                    <p class="missing-entries-tip">
                      ${d.message}
                    </p>
                  </div>
                </details>
              `;
            }

            statusMsg.innerHTML = `
              <h2>📝 More Entries Needed</h2>
              <p>${data.message}</p>
              ${diagnosticHTML}
              <a href="/entries" class="btn btn-primary cta-link">Add More Flashcards</a>
            `;
          } else if (!data.card) {
            document.querySelector('.question-box').classList.add('hidden');
            document.getElementById('options-container').classList.add('hidden');
            statusMsg.classList.remove('hidden');

            if (catchUpMode) {
              statusMsg.innerHTML = `
                <h2>✅ All Caught Up!</h2>
                <p>You've practiced all available cards. Great effort!</p>
                <button onclick="location.reload()" class="cta-button cta-primary">
                  ↺ Back to Dashboard
                </button>
              `;
            } else {
              statusMsg.innerHTML = `
                <h2>🎉 Great Job!</h2>
                <p>No cards are due for study today. You're all caught up!</p>
                <button onclick="startCatchUpMode()" class="cta-button cta-success">
                  📚 Practice More (Catch-up Mode)
                </button>
              `;
            }
          } else {
            alert('Error loading card options');
          }
        } catch (error) {
          console.error('[loadNextCard] Error:', error.message, error);
          if (statusMsg) {
            statusMsg.innerHTML = '<h2>⚠️ Error Loading Card</h2><p>' + error.message + '</p><p>Check browser console (F12) for details.</p>';
            statusMsg.classList.remove('hidden');
          }
        }
      }

      function displayOptions() {
        const container = document.getElementById('options-container');
        container.innerHTML = '';

        // Listen answer mode: no options; the user speaks the answer
        if (currentCard && currentCard.answer_mode === 'listen') {
          const note = document.createElement('p');
          note.className = 'listen-mode-note';
          note.textContent = '🎤 Listen mode: press "Say answer" and speak the answer aloud.';
          container.appendChild(note);
          const feedback = document.getElementById('voice-feedback');
          feedback.classList.remove('hidden');
          feedback.textContent = 'Your spoken answer is checked for pronunciation.';
          return;
        }

        // Several correct options (but not all) = select-all-that-apply
        const multiSelect = currentOptions.filter((option) => option.isCorrect).length > 1;

        currentOptions.forEach((option, index) => {
          const button = document.createElement('button');
          button.className = 'option-button';
          if (option.form === 'image' && option.media) {
            const img = document.createElement('img');
            img.src = option.media;
            img.alt = option.text || 'Option image';
            img.className = 'option-media-image';
            button.appendChild(img);
          } else if (option.form === 'audio' && option.media) {
            button.textContent = '🔈 ' + (option.text || 'Play and choose');
            const clip = new Audio(option.media);
            button.addEventListener('mouseenter', () => clip.play());
          } else {
            button.textContent = option.text;
            if (option.form === 'text_tts' && 'speechSynthesis' in window) {
              button.title = 'Double-click to hear this option';
              button.addEventListener('dblclick', (e) => {
                e.preventDefault();
                const u = new SpeechSynthesisUtterance(option.text);
                const optLang =
                  option.lang || (currentCard && (currentCard.answer_lang || currentCard.lang));
                if (optLang) u.lang = optLang;
                window.speechSynthesis.speak(u);
              });
            }
          }
          button.onclick = multiSelect
            ? () => {
                if (!answered) button.classList.toggle('selected');
              }
            : () => selectOption(index);
          button.disabled = answered;
          container.appendChild(button);
        });

        if (multiSelect) {
          const note = document.createElement('p');
          note.className = 'listen-mode-note';
          note.textContent = '☑️ Select all correct answers, then press Check Answers.';
          container.prepend(note);
          const checkBtn = document.createElement('button');
          checkBtn.type = 'button';
          checkBtn.id = 'check-answers-btn';
          checkBtn.className = 'next-button';
          checkBtn.textContent = 'Check Answers';
          checkBtn.onclick = submitMultiSelect;
          checkBtn.disabled = answered;
          container.appendChild(checkBtn);
        }
      }

      async function selectOption(optionIndex) {
        if (answered) return; // Prevent multiple answers
        answered = true;

        // Mark selected option
        const buttons = document.querySelectorAll('.option-button');
        buttons.forEach((btn) => {
          btn.disabled = true;
        });
        buttons[optionIndex].classList.add('selected');

        const selectedOption = currentOptions[optionIndex];
        await submitAnswer(selectedOption.text, selectedOption.isCorrect, (data) => {
          if (data.isCorrect) {
            buttons[optionIndex].classList.remove('selected');
            buttons[optionIndex].classList.add('correct');
          } else {
            buttons[optionIndex].classList.remove('selected');
            buttons[optionIndex].classList.add('incorrect');

            // Highlight correct answer or "None of the above"
            const correctIndex = currentOptions.findIndex((o) => o.isCorrect);
            buttons[correctIndex].classList.add('correct');
          }
        });
      }

      // Select-all-that-apply: correct only when the selected set matches the
      // correct set exactly.
      async function submitMultiSelect() {
        if (answered) return;
        const buttons = [...document.querySelectorAll('.option-button')];
        const selectedIdx = buttons
          .map((btn, i) => (btn.classList.contains('selected') ? i : -1))
          .filter((i) => i >= 0);
        if (selectedIdx.length === 0) return;
        answered = true;
        buttons.forEach((btn) => {
          btn.disabled = true;
        });
        const checkBtn = document.getElementById('check-answers-btn');
        if (checkBtn) checkBtn.disabled = true;

        const isCorrect = currentOptions.every(
          (option, i) => Boolean(option.isCorrect) === selectedIdx.includes(i)
        );
        const selectedAnswer = selectedIdx
          .map((i) => currentOptions[i].text || 'image option')
          .join('; ');
        await submitAnswer(selectedAnswer, isCorrect, (data) => {
          buttons.forEach((btn, i) => {
            if (i >= currentOptions.length) return;
            btn.classList.remove('selected');
            if (currentOptions[i].isCorrect) btn.classList.add('correct');
            else if (selectedIdx.includes(i)) btn.classList.add('incorrect');
          });
        });
      }

      async function submitAnswer(selectedAnswer, isCorrect, decorate) {
        try {
          // Get active filters from sessionStorage
          const studyFiltersJson = sessionStorage.getItem('studyFilters');
          const filters = studyFiltersJson ? JSON.parse(studyFiltersJson) : {};

          const response = await fetch('/api/practice/answer', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'include',  // Important: send cookies with request
            body: JSON.stringify({
              flashcardId: currentCard.flashcard_id,
              selectedAnswer,
              isCorrect,
              sessionStartTime: sessionStartTime,
              filterClass: filters.class || null,
              filterLesson: filters.lesson || null,
              filterCategory: filters.category || null,
            }),
          });

          console.log('[submitAnswer] Response status:', response.status);
          
          if (!response.ok) {
            throw new Error(`HTTP ${response.status}: ${response.statusText}`);
          }

          const data = await response.json();
          console.log('[submitAnswer] Response data:', data);

          if (data.status === 'success') {
            // Show feedback
            const feedbackEl = document.getElementById('feedback-message');
            let feedbackText = data.message;

            // If "None of the above" was the correct answer and user got it wrong, show actual answer
            if (!data.isCorrect && selectedAnswer !== 'None of the above') {
              const noneOfAboveOption = currentOptions.find((o) => o.isNoneOfAbove === true);
              if (noneOfAboveOption) {
                feedbackText += ` (Correct answer: ${currentCard.answer})`;
              }
            }

            // Add attempt counter and progress info if available
            if (data.session && data.session.attemptNumber !== undefined) {
              currentAttemptCount = data.session.attemptNumber;
              currentTotalAttempts = data.session.totalNeeded;
              
              if (data.session.needsMoreAttempts) {
                feedbackText += ` [Attempt ${currentAttemptCount}/${currentTotalAttempts}]`;
              } else {
                feedbackText += ` [Mastered! Moving to next card]`;
              }
            }

            feedbackEl.textContent = feedbackText;
            feedbackEl.className = data.isCorrect
              ? 'feedback-message feedback-correct'
              : 'feedback-message feedback-incorrect';

            // Style the option buttons for this answer mode
            decorate(data);

            // Show next button (or "repeat" if more attempts needed)
            const nextBtn = document.getElementById('next-button');
            if (data.session && data.session.needsMoreAttempts) {
              nextBtn.textContent = '↻ Try Again';
            } else {
              nextBtn.textContent = 'Next Card';
            }
            nextBtn.classList.remove('hidden');

            // Refresh stats after each answer
            console.log('[submitAnswer] Refreshing stats after answer submission...');
            await refreshStatsForActiveFilters();
          } else {
            alert('Error: ' + data.error);
          }
        } catch (error) {
          console.error('Error submitting answer:', error);
          alert('Error submitting answer');
        }
      }
    </script>

