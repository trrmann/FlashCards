# ==========================================
# FLASHCARDS .env CONFIGURATION
# ==========================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# ==========================================
# DATABASE CONFIGURATION
# Required: Fill these from your Render database
# ==========================================

# Full connection string from Render
# Format: postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE
# Get this from Render dashboard under "External Database URL"
DATABASE_URL=postgresql://app_admin:YOUR_PASSWORD_HERE@your-host-here.render-ov.postgres.databases.render.com:5432/dev_apps

# Individual components (in case DATABASE_URL parsing fails)
DB_HOST=your-host-here.render-ov.postgres.databases.render.com
DB_PORT=5432
DB_NAME=dev_apps
DB_USER=app_admin
DB_PASSWORD=YOUR_PASSWORD_HERE

# PostgreSQL schema for this application (isolates from other apps)
# Use: flashcards_schema
DB_SCHEMA=flashcards_schema

# Connection pooling
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=2000

# ==========================================
# AUTHENTICATION
# Required: Generate JWT_SECRET
# Run: openssl rand -hex 32
# ==========================================

# 32-character random hex string
# Generate with: openssl rand -hex 32
# Or on Windows PowerShell: [System.Convert]::ToHexString([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
JWT_SECRET=YOUR_32_CHARACTER_SECRET_HERE_GENERATE_WITH_OPENSSL

# Token expiration
JWT_EXPIRATION=7d
JWT_REFRESH_EXPIRATION=30d

# Password hashing
BCRYPT_ROUNDS=10

# ==========================================
# APPLICATION CONFIGURATION
# ==========================================

# Node environment
NODE_ENV=development

# Server port
PORT=5000

# Server hostname
HOST=localhost

# ==========================================
# CORS CONFIGURATION
# ==========================================

# Allowed origin for cross-origin requests
CORS_ORIGIN=http://localhost:5000
CORS_CREDENTIALS=true

# ==========================================
# SESSION CONFIGURATION
# ==========================================

# Max session duration in milliseconds (1 hour)
SESSION_MAX_DURATION=3600000

# Study session timeout in milliseconds (5 minutes)
STUDY_SESSION_TIMEOUT=300000

# ==========================================
# LOGGING
# ==========================================

# Log level: debug, info, warn, error
LOG_LEVEL=debug

# ==========================================
# PAGINATION
# ==========================================

# Default page size for list endpoints
DEFAULT_PAGE_SIZE=20

# Maximum page size (prevent abuse)
MAX_PAGE_SIZE=100

# ==========================================
# RATE LIMITING (Optional - for future)
# ==========================================

# Rate limit window in milliseconds (15 minutes)
RATE_LIMIT_WINDOW=900000

# Max requests per window
RATE_LIMIT_MAX_REQUESTS=100

# ==========================================
# FEATURE FLAGS
# ==========================================

# Enable/disable import/export functionality
ENABLE_IMPORT_EXPORT=true

# Enable/disable quiz mode
ENABLE_QUIZ_MODE=true

# Enable/disable analytics
ENABLE_ANALYTICS=false
