{
  "folders": [
    {
      "path": ".",
    },
  ],
  "settings": {
    // Put every script in src/scripts/sh on PATH for the VS Code terminal.
    "terminal.integrated.env.linux": {
      "PATH": "${workspaceFolder}/src/scripts/sh:${env:PATH}",
    },
    "terminal.integrated.env.osx": {
      "PATH": "${workspaceFolder}/src/scripts/sh:${env:PATH}",
    },
    // Project-local terminal: loads ~/.bashrc, then FlashCards' scripts and the deploy alias.
    // See .vscode/terminal-rc.sh (these used to be global in ~/.bashrc).
    "terminal.integrated.profiles.linux": {
      "FlashCards bash": {
        "path": "bash",
        "args": ["--rcfile", "${workspaceFolder}/.vscode/terminal-rc.sh"],
      },
    },
    "terminal.integrated.defaultProfile.linux": "FlashCards bash",
  },
}
